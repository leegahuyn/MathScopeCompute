MathScope.M4.FiniteAcceptance.delta_two_precision (x y : Int) (N : Nat) :
  MathScope.M4.FiniteAcceptance.deltaNumerator x y % (2 * 2 ^ N) / 2 =
    MathScope.M4.FiniteAcceptance.deltaTwo x y % 2 ^ N
