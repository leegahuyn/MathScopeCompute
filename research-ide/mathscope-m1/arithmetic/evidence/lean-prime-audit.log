MathScope.M1.Arithmetic.prime_interval_complete (a b n : ℕ) :
  n ∈ MathScope.M1.Arithmetic.primesIn a b ↔ a ≤ n ∧ n ≤ b ∧ Nat.Prime n
'MathScope.M1.Arithmetic.prime_interval_complete' depends on axioms: [propext, Classical.choice, Quot.sound]
MathScope.M1.Arithmetic.sieve_square_root_guard (n : ℕ) (hn : 2 ≤ n) (guard : ∀ (d : ℕ), 2 ≤ d → d ≤ n.sqrt → ¬d ∣ n) :
  Nat.Prime n
'MathScope.M1.Arithmetic.sieve_square_root_guard' depends on axioms: [propext, Classical.choice, Quot.sound]
MathScope.M1.Arithmetic.prime_only_square_root_guard (n : ℕ) (hn : 2 ≤ n)
  (guard : ∀ (q : ℕ), Nat.Prime q → q ≤ n.sqrt → ¬q ∣ n) : Nat.Prime n
'MathScope.M1.Arithmetic.prime_only_square_root_guard' depends on axioms: [propext, Classical.choice, Quot.sound]
MathScope.M1.Arithmetic.segmented_sieve_complete_on_interval (a b n : ℕ) (base : Finset ℕ) (hn : n ≤ b)
  (sound : ∀ q ∈ base, Nat.Prime q) (complete : ∀ (q : ℕ), Nat.Prime q → q ≤ b.sqrt → q ∈ base) :
  (a ≤ n ∧ 2 ≤ n ∧ ∀ q ∈ base, q ≤ n.sqrt → ¬q ∣ n) ↔ a ≤ n ∧ Nat.Prime n
'MathScope.M1.Arithmetic.segmented_sieve_complete_on_interval' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
MathScope.M1.Arithmetic.lucas_certificate_sound (p : ℕ) (a : ZMod p) (ha : a ^ (p - 1) = 1)
  (hd : ∀ (q : ℕ), Nat.Prime q → q ∣ p - 1 → a ^ ((p - 1) / q) ≠ 1) : Nat.Prime p
'MathScope.M1.Arithmetic.lucas_certificate_sound' depends on axioms: [propext, Classical.choice, Quot.sound]
MathScope.M1.Arithmetic.pi_ten : (MathScope.M1.Arithmetic.primesIn 2 10).card = 4
