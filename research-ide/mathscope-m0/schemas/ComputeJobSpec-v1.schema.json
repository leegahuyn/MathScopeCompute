  "required": [
    "schema",
    "id",
    "modelRef",
    "adapter",
    "sourceRefs",
    "assumptionRefs",
    "scope",
    "precision",
    "seed",
    "domain",
    "basis",
    "budget",
    "input"
  ],
  "additionalProperties": false
