{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathscope:schema:ComputeJobSpec:1",
  "title": "MathScope ComputeJobSpec v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "MathScope.ComputeJobSpec/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
