    "precision": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "EXACT",
            "PADIC",
            "REAL_INTERVAL",
            "COMPLEX_INTERVAL",
            "FLOAT64",
            "STATISTICAL"
          ]
        },
        "p": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$"
        },
        "digits": {
          "type": "integer",
          "minimum": 1
        },
        "absoluteBits": {
          "type": "integer",
          "minimum": 1
        },
        "workingBits": {
          "type": "integer",
          "minimum": 1
        },
        "guardDigits": {
          "type": "integer",
          "minimum": 0
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
