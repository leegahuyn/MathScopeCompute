        "maxBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxOperations": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxMillis",
        "maxBytes",
        "maxItems"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object"
    }
