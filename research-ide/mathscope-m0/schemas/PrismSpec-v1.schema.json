          "minItems": 1
        },
        "presentation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "generators",
        "presentation"
      ],
      "additionalProperties": false
    },
    "delta": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "inputExtraDigits": {
          "type": "integer",
          "minimum": 1
