        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "assumptionRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "p": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$"
    },
    "ring": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "PADIC_INTEGER_RING",
            "AFFINE_PRESENTATION",
            "AINF",
            "PERFECTOID_PRESENTATION"
          ]
        },
        "presentation": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "presentation",
        "completion"
      ],
      "additionalProperties": false
    },
    "ideal": {
      "type": "object",
      "properties": {
        "generators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
