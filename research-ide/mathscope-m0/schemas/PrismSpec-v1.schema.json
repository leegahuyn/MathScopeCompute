        "convention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rule",
        "inputExtraDigits",
        "convention"
      ],
      "additionalProperties": false
    },
    "frobenius": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "convention": {
          "type": "string",
          "minLength": 1
        },
        "semilinear": {
          "const": true
        },
        "cutoffRule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rule",
        "convention",
        "semilinear",
        "cutoffRule"
      ],
      "additionalProperties": false
