      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "POINT",
            "PROJECTIVE_SPACE",
            "SMOOTH_AFFINE",
            "SMOOTH_PROPER",
            "USER_PRESENTATION"
          ]
