{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathscope:schema:PrismSpec:1",
  "title": "MathScope PrismSpec v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "MathScope.PrismSpec/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
