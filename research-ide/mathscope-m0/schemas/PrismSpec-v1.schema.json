      },
      "required": [
        "kind",
        "presentation",
        "dimension"
      ],
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "object",
      "properties": {
        "smooth": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "proper": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "smooth",
        "proper",
        "details"
      ],
      "additionalProperties": false
