  "required": [
    "schema",
    "id",
    "revision",
    "sourceRefs",
    "assumptionRefs",
    "p",
    "ring",
    "ideal",
    "delta",
    "frobenius",
    "geometricObject",
    "hypotheses",
    "comparison",
    "prismPredicate",
    "scope",
    "semanticStatus"
  ],
  "additionalProperties": false
}
