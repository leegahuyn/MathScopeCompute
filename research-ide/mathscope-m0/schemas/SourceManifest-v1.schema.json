{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathscope:schema:SourceManifest:1",
  "title": "MathScope SourceManifest v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "MathScope.SourceManifest/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "kind": {
            "enum": [
              "CODE",
              "PAPER",
              "DATA",
              "WEB",
              "LEAN_SOURCE",
              "LOCKFILE",
              "BASELINE"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": [
              "AVAILABLE",
              "REFERENCED",
              "MISSING"
            ]
          },
          "locator": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "uri",
          "sha256",
          "availability"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "id",
    "revision",
    "entries"
  ],
  "additionalProperties": false
}
