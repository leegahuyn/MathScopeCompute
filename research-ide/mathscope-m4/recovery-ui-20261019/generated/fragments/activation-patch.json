계와 전체 q 구간을 보장하는 명시 log a_j 선택식을 유도·구현.\",\"remaining\":[\"실제 스케줄/active indices/생략 tail의 값 미계산\"]},\"N7-04\":{\"title\":\"Terminal force jets\",\"status\":\"PARTIAL\",\"summary\":\"열 외곽 전체 양의 반경 영역의 F_j(r,z) 0–6차 식과 임의 고정 차수 재귀를 구성.\",\"remaining\":[\"q 양수인 나머지 K에서 final-potential endpoint jets\",\"원점 final residual flatness 적용\"]},\"N7-05\":{\"title\":\"t>1 force extension\",\"status\":\"PARTIAL\",\"summary\":\"최소 증가 정수 b_j 선택기·혼합 도함수 tail·jet 접합을 구현. b0=1.\",\"remaining\":[\"전체 K의 F_j 노름 없으므로 실제 b1 이후는 미선택\"]},\"N7-06\":{\"title\":\"전역 에너지 balance\",\"status\":\"PARTIAL\",\"summary\":\"실제 초기 10개 lift 표현의 각도별 에너지·소산·외력일·force norm 적분식을 원통 기저항 포함 구성.\",\"remaining\":[\"최종 localized 장의 전체 K 활성 시간 적분\",\"독립 공간/시간 에너지 defect 감소\"]},\"N8-05\":{\"title\":\"공간·급수·정밀도 적응\",\"status\":\"PARTIAL\",\"summary\":\"각도 harmonic의 alias 조건과 5→10→20 carrier 주기 해상도 비교, 독립 축 2배 비교기를 구현.\",\"remaining\":[\"실제 annular auxiliary Fourier/r,z/order/precision 비교 및 tail\",\"last-resolved tau 미계산\"]}};const pages={P7:34,P8:36,Y5:46,Y6:48,Y7:50,N6:62,N7:64,N8:66};d.ledger={complete:57,total:64,rows:Object.keys(pages).flatMap(p=>Array.from({length:8},(_,i)=>{const id=p+'-'+String(i+1).padStart(2,'0');return {id,title:id,blueprint_page:pages[p],status:'INHERITED_COMPLETE',summary:'기존 원래 인수 범위 승계. 이번 재실행 아님.',remaining:[],...special[id]}}))};return d})();const EXPECTED='14f5d2edbaed921c97dcfd42a3a5be3485be83b671cbdffafe5101197718cf10';const panel=document.getElementById('ms3ip');if(!panel)return;const $=id=>document.getElementById('ms3ip-'+id);const txt=(id,s)=>$(id).textContent=s;const selected=sel=>data.ledger.rows.find(r=>r.id===sel);const q=s=>{const a=String(s).split('/').map(Number);return a.length===2?a[0]/a[1]:a[0]};function option(el,value,label){const o=document.createElement('option');o.value=value;o.textContent=label;el.append(o)}function view(name){panel.querySelectorAll('[data-pane]').forEach(el=>el.hidden=el.dataset.pane!==name);panel.querySelectorAll('[data-view]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.view===name)))}$('open').addEventListener('click',()=>panel.showModal());$('close').addEventListener('click',()=>panel.close());panel.addEventListener('close',()=>$('open').focus());panel.querySelectorAll('[data-view]').forEach(el=>el.addEventListener('click',()=>view(el.dataset.view)));function criterion(){const row=selected($('criterion').value);if(!row)return;txt('ctitle',row.id+' · '+row.title);txt('cstatus','판정: '+row.status+' · 설계도 '+row.blueprint_page+'쪽');txt('csummary',row.summary);txt('cremain',row.remaining.length?'남음: '+row.remaining.join(' / '):'추가된 미해결 조건 없음. 표기한 원본 인수 범위만 적용.');txt('coriginal',row.original_criterion||'원래 기준 전문: 같은 UI_DATA.json을 읽으면 표시됩니다. 기존 기준을 새 요약으로 대체하지 않습니다.')}function norm(){const n=data.norms[Number($('norm').value)];txt('normnumbers','목표 '+n.target+' / 확보 '+n.bound_exponent+' / 지수 여유 '+n.margin);const svg=$('chart');svg.replaceChildren();const ns='http://www.w3.org/2000/svg';function node(tag,attrs,text){const e=document.createElementNS(ns,tag);for(const k in attrs)e.setAttribute(k,attrs[k]);if(text)e.textContent=text;svg.append(e)}[['목표',n.target,'#7b919b'],['확보',n.bound_exponent,'#208168']].forEach(([label,value,color],i)=>{node('text',{x:15,y:45+i*62,'font-size':17},label+' '+value);node('rect',{x:185,y:24+i*62,width:Math.max(0,q(value)/2.1*390),height:27,fill:color});});txt('normdetail',JSON.stringify({id:n.id,source_roots:n.roots,class:n.class,required_exponent:n.target,bound_exponent:n.bound_exponent,margin:n.margin,grade:'동일 현재 초기 소스 정리 적용; 수치 C는 미평가',domain:data.domain,evidence:n.evidence,source:data.source},null,2))}function jet(){const j=Number($('jet').value);const row=data.terminal?.rows.find(r=>r.j===j);txt('jetdetail',row?JSON.stringify(row,null,2):'j='+j+'\\nk_j=c∞·2^A·4^j·(h)_j(1+h)_j·r^(-1-2h-2j)\\nS_j=Σ binom(j,l) k_l k_(j-l) 의 계수\\np_j=−S_j·r^(-2-4h-2j)/(2+4h+2j)\\nF_r=chi_r p_j+chi(1−chi) Dt^j(K²)/r\\nF_theta=−2chi_r k_j′−(chi_rr+chi_r/r+chi_zz)k_j\\nF_z=chi_z p_j\\n실제 소수값 없음. 전체 식은 검증된 UI_DATA.json에 포함.')}function alias(){const n=Number($('samples').value);const bad=[-4,-3,-2,-1,1,2,3,4].filter(k=>k%n===0);txt('alias',bad.length?'force norm 곱의 alias: '+bad.join(', ')+' · 부족한 해상도':'현재 초기 angular 곱(최대 |m|=4): 정확한 직교 합. 생략 angular 곱 없음.')}function originals(){const rows=data.original_rows;if(!rows){txt('originalstate','원본 1,260개 완료 상태는 승계했습니다. 개별 ID 장부는 파일 로딩 대기 중이며, 아직 화면에 없는 항목을 0개로 표시하지 않습니다.');$('original').disabled=true;txt('originaldetail','패키지의 evidence/UI_DATA.json을 선택하세요. SHA-256이 일치하는 파일만 이 패널의 고정 증거로 읽습니다.');return}txt('originalstate',rows.length+'개 원본 ID · 기존 PASS와 그 근거를 표시. 이번 재증명 아님.');const search=$('search').value.trim();$('original').replaceChildren();rows.filter(r=>!search||r.id.includes(search)).forEach(r=>option($('original'),r.id,r.id+' · '+r.family));$('original').disabled=false;originalDetail()}function originalDetail(){const row=data.original_rows?.find(r=>r.id===$('original').value);txt('originaldetail',row?JSON.stringify({...row,source_ledger_sha256:data.original_ledger_hash},null,2):'해당 ID가 없습니다. 원본 장부에서 삭제된 것으로 해석하지 않습니다.')}function init(){const current=$('criterion').value||'N6-01';$('criterion').replaceChildren();$('grid').replaceChildren();data.ledger.rows.forEach(r=>{option($('criterion'),r.id,r.id+' · '+r.title);const b=document.createElement('button');b.type='button';b.textContent=r.id;b.dataset.status=r.status;b.setAttribute('aria-label',r.id+' '+r.status);b.addEventListener('click',()=>{$('criterion').value=r.id;criterion()});$('grid').append(b)});$('criterion').value=current;$('norm').replaceChildren();data.norms.forEach((r,i)=>option($('norm'),i,r.id));criterion();norm();jet();alias();originals()}$('criterion').addEventListener('change',criterion);$('norm').addEventListener('change',norm);for(let j=0;j<=6;j++)option($('jet'),j,j);$('jet').addEventListener('change',jet);$('samples').addEventListener('change',alias);$('search').addEventListener('input',originals);$('original').addEventListener('change',originalDetail);$('export').addEventListener('click',()=>{const n=data.norms[Number($('norm').value)];const out={schema:'MathScope.M3.SelectedEvidence/1',norm:n,source:data.source,domain:data.domain,M3:'57/64',N6_02:'PARTIAL_DEFERRED'};const url=URL.createObjectURL(new Blob([JSON.stringify(out,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download=n.id+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});$('import').addEventListener('change',async()=>{txt('error','');try{const f=$('import').files[0];if(!f)return;if(f.size>2500000)throw Error('파일 한도 2.5MB 초과');const raw=await f.arrayBuffer();if(!globalThis.crypto?.subtle)throw Error('이 실행 문맥에는 WebCrypto가 없습니다. HTTPS 운영 페이지에서 파일 검증을 실행하세요. 정책은 변경하지 않습니다.');const hash=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',raw))).map(v=>v.toString(16).padStart(2,'0')).join('');if(hash!==EXPECTED)throw Error('고정 UI 데이터 SHA-256 불일치. 기존 상태를 유지합니다.');const next=JSON.parse(new TextDecoder().decode(raw));if(next.schema!=='MathScope.M3.IntegratedView/1'||next.original_rows?.length!==1260||next.ledger.rows.length!==64||next.ledger.complete!==57)throw Error('자료 범위 불일치');data=next;init();txt('error','같은 고정 증거 파일을 읽었습니다.');txt('datascope','64개 원문 기준과 1,260개 ID별 증거를 고정 파일에 연결했습니다.')}catch(e){txt('error',e.message)}});view('criteria');init();panel.dataset.ready='true';})();\n</script>\n<!-- MathScope M3 integrated 20261016 END -->","replace":"<!-- MathScope M3 integrated 20261016 BEGIN -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-layout\" -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-data-00\" -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-data-01\" -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-data-02\" -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-data-03\" -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-data-04\" -->\n<!--#wps-include fragment=\"msr-20261019-cf98-a0aece9b-da