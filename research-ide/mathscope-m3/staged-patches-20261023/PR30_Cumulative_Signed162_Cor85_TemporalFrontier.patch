@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {assembleSigned162Candidate as assemble,SIGNED_162_SCHEMA} from '../navier/generic-signed-162-indexed.mjs';
+
+class Graph{
+  constructor(){this.nodes=[];this.indexed=new Map();this.zero=this.addNode('zero',[]);this.one=this.addNode('one',[])}
+  addNode(op,args){const id=this.nodes.length;this.nodes.push({op,args});return id}
+  fresh(tag='source'){return this.addNode('coordinate',[tag])}
+  q(a,b){return this.addNode('rational',[a,b])}
+  add(...a){return this.addNode('add',a)}
+  sub(a,b){return this.addNode('sub',[a,b])}
+  mul(...a){return this.addNode('mul',a)}
+  div(a,b){return this.addNode('div',[a,b])}
+  neg(a){return this.addNode('neg',[a])}
+  pow(a,b){return this.addNode('pow',[a,b])}
+  sqrt(a){return this.addNode('sqrt_positive',[a])}
+  exp(a){return this.addNode('exp',[a])}
+  log(a){return this.addNode('log',[a])}
+  cosine(a){return this.addNode('cosine',[a])}
+  sine(a){return this.addNode('sine',[a])}
+  choose(...a){return this.addNode('choose',a)}
+  simultaneousSubstitute(body,variables,values){return this.addNode('substitute',[body,variables,values])}
+  defineExpressionFunction(x){return this.addNode('expression_def',[x])}
+  expressionValue(id,values){return this.addNode('expression_apply',[id,values])}
+  definePeriodicIndexedField(x){const id=this.addNode('indexed_def',[x.name,x.rows.length]);this.indexed.set(id,x);return id}
+  periodicIndexedSystem(id){return this.indexed.get(id)}
+  periodicIndexedValue(id,params){return this.addNode('indexed_apply',[id,params])}
+}
+function fixture(){
+  const G=new Graph(),n=(tag)=>G.fresh(tag??'p'),
+    R=n('R'),Z=n('Z'),T=n('T'),theta=n('theta'),ell=n('ell'),
+    Xrep=n('Xrep'),etaRep=n('etaRep'),sRep=n('sRep'),xi=n('xi'),v=n('v'),
+    Y=[n('Y0'),n('Y1')],fields={b:n('b'),F:n('F'),G:n('G'),pressure:n('pressure')},
+    param=[R,Z,T,ell,...Array.from({length:3},(_,i)=>n('grid'+i)),...Y,n('center0'),n('center1'),n('copy0'),n('copy1'),theta,n('level')],
+    coverParameters=[R,Z,T,ell,n('covgrid0'),n('covgrid1'),n('covgrid2'),...Y],
+    bands=Array.from({length:3},(_,i)=>({delta:n('band-delta-'+i)})),
+    coverRows=Array.from({length:81},(_,i)=>({key:'label-'+i,relativeBand:i%3-1,
+      label:{key:'label-'+i,ell:n('label-ell'),grid:Array.from({length:3},()=>n('grid'))},
+      guards:[{sourceGuard:i}],signs:[0,1].map(j=>({sign:j?'minus':'plus',sourceLocalRow:j,
+        rectangle:{center:[n('center'),n('center')],copy:[n('copy'),n('copy')]}}))})),
+    cover={rows:coverRows,bands,parameters:coverParameters,directions:[R,Z,T,...Y],
+      proof:{allCrossLabelProductsVanish:true,localFinitenessAndFlatJoins:true,exactSourceAuthority:true}},
+    geometry={R,Z,T,Y,radialFast:n('radialFast')},
+    band={G,coordinates:{R,Z,T,theta,ell,Xrep,etaRep,sRep,v},cutoffs:{xi},geometry:{r0:n('r0'),Ls:n('Ls')},
+      constants:{A:n('A'),D:n('D')},fields},
+    current={G,band,geometry:{...geometry},local:{slowCutoff:{body:n('cutoff')},parameters:param},
+      representative:{roots:{X:n('X'),eta:n('eta'),s:n('s')}}};
+  const pressure={G,current,cover,geometry,pressure:{rho:n('rho'),chi:n('chi')}},
+    forcedInput={G,mean:{temporal:{pressure}},coordinates:{levelDifference:n('level'),localParameters:param},
+      reference:{ratio:n('ratio')}},
+    C={value:(real=G.zero,imaginary=G.zero)=>({real,imaginary}),
+      check:z=>Number.isSafeInteger(z?.real)&&Number.isSafeInteger(z?.imaginary)&&!!G.nodes[z.real]&&!!G.nodes[z.imaginary],
+      conjugate:z=>({real:z.real,imaginary:G.neg(z.imaginary)}),
+      add:(...xs)=>({real:G.add(...xs.map(x=>x.real)),imaginary:G.add(...xs.map(x=>x.imaginary))})},
+    baseWave=()=>[-4,-2,-1,1,2,4].map(m=>({m,velocity:Array.from({length:3},()=>C.value(n(),n())),pressure:C.value(n(),n())})),
+    templates=Array.from({length:10},(_,i)=>{
+      const signIndex=Math.floor(i/5),levelDifference=i%5,sign=signIndex?'minus':'plus';
