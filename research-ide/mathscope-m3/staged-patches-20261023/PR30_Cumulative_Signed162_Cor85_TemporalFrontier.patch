+/** Exact finite structural audit for a proposed original Signed162 successor.
+ *
+ * NOT a source authority: this function admits fixture inputs for regression
+ * tests. Only original-signed-162-successor.mjs may create a source seal by
+ * using the original `assertGlobalForcedCurrent` and `assertGlobalInitializedAngular`.
+ * This audits AST inventories, not numerical values or analytic all-order bounds.
+ */
+const COMPONENTS=Object.freeze(['rr','rtheta','rz','thetatheta','thetaz','zz']);
+const fail=(code,message)=>{throw Object.assign(new Error(message),{code});};
+const node=(G,x)=>Number.isSafeInteger(x)&&x>=0&&!!G.nodes?.[x];
+const requireRoot=(G,x,where)=>{if(!node(G,x))fail('MISSING_SIGNED_ROOT',where);};
+const same=(x,y)=>JSON.stringify(x)===JSON.stringify(y);
+function requireVec(G,x,n,where){
+  if(!Array.isArray(x)||x.length!==n)fail('INCOMPLETE_SIGNED_VECTOR',where);
+  x.forEach((v,i)=>requireRoot(G,v,where+'['+i+']'));
+}
+function checkModes(G,before,after,key){
+  const get=(rows)=>new Map(rows.map(row=>[row.m,row]));
+  if(!Array.isArray(before)||!Array.isArray(after)||after.length>257)fail('INVALID_SIGNED_MODES',key);
+  const B=get(before),A=get(after),ids=[...A.keys()].sort((a,b)=>a-b);
+  if(A.size!==after.length||B.size!==before.length||!ids.every(x=>x!==0&&A.has(-x)))
+    fail('INVALID_SIGNED_MODES',key+': duplicated, zero, or unpaired harmonic');
+  for(const [mode,row] of A){
+    if(!Number.isSafeInteger(mode)||!Array.isArray(row.velocity)||row.velocity.length!==3)
+      fail('INCOMPLETE_SIGNED_MODE',key);
+    for(const [j,x] of [...row.velocity,row.pressure].entries()){
+      requireRoot(G,x?.real,key+':'+mode+':'+j+':real');
+      requireRoot(G,x?.imaginary,key+':'+mode+':'+j+':imaginary');
+    }
+  }
+  if([...B.keys()].some(x=>!A.has(x)))fail('LOST_FORCED_HARMONIC',key);
+  if(!A.has(-1)||!A.has(1))fail('LOST_SIGNED_HARMONIC',key);
+}
+function indexRows(G,field,cover,templates,name,angular){
+  requireRoot(G,field?.field,name+': definition');
+  requireRoot(G,field?.root,name+': root');
+  const registry=G.periodicIndexedSystem?.(field.field);
+  if(!registry||!Array.isArray(registry.rows)||registry.rows.length!==162||
+     !Array.isArray(field.systems)||field.systems.length!==2||
+     field.contributionCount!==162||field.angular!==angular)
+    fail('INCOMPLETE_162_REGISTRY',name);
+  for(let i=0;i<81;i++){
+    const origin=cover.rows[i],band=cover.bands[origin.relativeBand+1];
+    if(!band||band.delta===undefined)fail('MISSING_SIGNED_BAND',name+':'+i);
+    for(let j=0;j<2;j++){
+      const signed=origin.signs[j],row=registry.rows[2*i+j],f=field.systems[signed.sourceLocalRow];
+      if(!f||!row||row.localSystem!==f.system||row.guards!==origin.guards||
+         row.label?.key!==origin.key||row.label?.sign!==signed.sign||
+         row.label?.fixedDifference!==band.delta||row.label?.countBoxOnce!==true||
+         !Array.isArray(row.values)||row.values.length!==(angular?16:15)||
+         !Array.isArray(row.derivativeMaps)||!same(row.derivativeMaps.map(x=>x?.[0]?.parameter),angular?[0,1,2,8,9,14]:[0,1,2,8,9]))
+        fail('SIGNED_ROW_PROVENANCE_MISMATCH',name+':'+i+':'+j);
+    }
+  }
+  for(const s of field.systems){
+    if(!same(s.retainedDifferences,[0,1,2,3,4]))
+      fail('MISSING_FIVE_COVER_DIFFERENCES',name);
+  }
+  return {name,field:field.field,root:field.root,rows:registry.rows.length,angular};
+}
+/** Validates every closed finite *expression* required before issuing a seal.
+ * Boolean certificate flags are not accepted instead of the graph operands.
+ */
+export function auditSigned162SuccessorFacts(result){
+  const forced=result?.originalForced,G=result?.G;
+  if(result?.schema!=='MathScope.N6.GenericSigned162IndexedCandidate/1'||!forced||G!==forced.G||
+     !Array.isArray(G?.nodes)||!Array.isArray(result.templates)||result.templates.length!==10)
+    fail('WRONG_ORIGINAL_SIGNED_GRAPH','A complete Signed162 source graph is required.');
+  const pressure=forced.input?.mean?.temporal?.pressure,cover=pressure?.cover;
+  if(!Array.isArray(cover?.rows)||cover.rows.length!==81||
+    new Set(cover.rows.map(x=>x.key)).size!==81||
+    cover.proof?.exactSourceAuthority!==true||cover.proof?.allCrossLabelProductsVanish!==true||
+    cover.proof?.localFinitenessAndFlatJoins!==true)
+    fail('INVALID_ORIGINAL_81_COVER','The authenticated complete 81-box source is required.');
+  const keys=new Set(),bySign=[[],[]];
+  for(const t of result.templates){
+    if(![0,1].includes(t.signIndex)||!Number.isSafeInteger(t.levelDifference)||
+       t.levelDifference<0||t.levelDifference>4||t.key!==`${t.levelDifference}:${t.sign}`||
+       keys.has(t.key)||!Array.isArray(t.signedRows)||
+       !same(t.signedRows.map(x=>x.m),[1,-1]))
+      fail('INCOMPLETE_SIGNED_TEMPLATE','All 10 original signed templates are required.');
+    keys.add(t.key);bySign[t.signIndex].push(t.levelDifference);
+    checkModes(G,forced.templates.find(x=>x.key===t.key)?.waveRows,t.waveRows,t.key);
+    for(const component of COMPONENTS){
+      requireRoot(G,t.beforeCovariance?.values?.[component],t.key+':before:'+component);
+      requireRoot(G,t.afterCovariance?.values?.[component],t.key+':after:'+component);
+      requireRoot(G,t.deltaCovariance?.[component],t.key+':delta:'+component);
+    }
+  }
+  if(bySign.some(a=>!same(a.sort((a,b)=>a-b),[0,1,2,3,4])))
+    fail('MISSING_COVERING_BRANCH','All five original differences per sign are mandatory.');
+  for(const r of cover.rows){
+    if(!Array.isArray(r.signs)||r.signs.length!==2||
+       !same(r.signs.map(x=>x.sourceLocalRow).sort(),[0,1])||
+       r.signs.some(x=>x.sign!==result.templates.find(t=>t.signIndex===x.sourceLocalRow)?.sign))
+      fail('SOURCE_SIGN_INVENTORY_MISMATCH','Both original signs must be retained in each label.');
+  }
+  const indexed=result.indexed,fields=[
+    ...Array.from({length:3},(_,i)=>({name:'velocity'+i,field:indexed?.velocity?.[i],angular:true})),
+    {name:'angularPressure',field:indexed?.angularPressure,angular:true},
+    ...COMPONENTS.map(k=>({name:'covariance_'+k,field:indexed?.covariance?.[k],angular:false}))
+  ];
+  const inventories=fields.map(row=>indexRows(G,row.field,cover,result.templates,row.name,row.angular));
+  if(new Set(inventories.map(x=>x.field)).size!==10||new Set(inventories.map(x=>x.root)).size!==10)
+    fail('DUPLICATE_SIGNED_GLOBAL_FIELD','Distinct source fields are required.');
+  const updated=result.updated;
+  if(!updated||result.scope?.originalFullPressureRecomputed!==true||
+     result.scope?.originalPhysicalPDERecomputed!==true||
+     result.scope?.sourceIndexed162SignedASTConstructed!==true||
+     result.scope?.originalFinal67JetsEvaluated!==0||
+     result.scope?.N706Closed!==false||result.scope?.N805Closed!==false)
+    fail('SIGNED_FULL_REFRESH_INCOMPLETE','Full pressure/P/J/PDE roots are not optional.');
+  requireVec(G,updated.fullVelocity,3,'complete Signed velocity');
+  requireRoot(G,updated.fullPressure,'complete Signed pressure');
+  requireRoot(G,updated.meanPressureDifference,'Signed pressure difference');
+  requireVec(G,updated.pde?.conservativeResidual,3,'complete physical PDE residual');
+  for(const comp of COMPONENTS)requireRoot(G,updated.updatedCovariance?.[comp],'new covariance '+comp);
+  for(const name of ['P','Jtheta','Jz'])
+    requireRoot(G,updated.updatedMean?.mean?.[name],'fresh '+name);
+  requireRoot(G,updated.updatedMean?.pressure?.value,'fresh full mean pressure');
+  if(!Array.isArray(updated.updatedMean?.checks)||!updated.updatedMean.checks.length||
+     updated.updatedMean.checks.some(x=>x.pass!==true)||
+     updated.updatedMean.mean.fullAngularCovariance!==updated.updatedCovariance)
+    fail('SIGNED_PRESSURE_REFRESH_UNVERIFIED','The newly refreshed mean/P/J must be fully checked.');
+  return {schema:'MathScope.N6.Signed162StructuralAudit/1',
+    originalSourceAuthenticatedByThisGenericAudit:false,sourcePrivateAuthorityIssued:false,
+    originalTemplateCount:10,labels:81,signContributionsPerField:162,
+    indexedFields:inventories,allIndexedRows:1620,
+    rootInventory:{velocity:[...updated.fullVelocity],pressure:updated.fullPressure,
+      pdeResidual:[...updated.pde.conservativeResidual],defects:['P','Jtheta','Jz'].map(k=>updated.updatedMean.mean[k]),
+      covariance:COMPONENTS.map(k=>updated.updatedCovariance[k])},
+    originalFieldNumericalEnclosures:0,allOrderAnalysisCertified:false,
+    N706Closed:false,N805Closed:false,release:'HOLD'};
+}
diff --git a/research-ide/mathscope-m3/navier/source-signed-temporal-frontier.mjs b/research-ide/mathscope-m3/navier/source-signed-temporal-frontier.mjs
