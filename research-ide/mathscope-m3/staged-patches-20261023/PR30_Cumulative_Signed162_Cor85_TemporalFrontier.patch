+/** A source-specific, repeatable full-current pressure / PDE residual refresh.
+ * Reuses the ORIGINAL exact updated mean pressure and full cylindrical PDE
+ * constructors. This is NOT a new private seal for Forced/Signed/Temporal/
+ * Five successors: it is a real source-AST consumer for supplied currents.
+ */
+import {assertGlobalInitializedAngular} from './source-initialized-angular.mjs';
+import {reconstructUpdatedFullMeanPressure} from './source-updated-mean-pressure.mjs';
+import {exactRealCylindricalPDE} from './source-harmonic-assembly.mjs';
+
+const fail=(code,message)=>{const e=new Error(message);e.code=code;throw e;};
+
+/** Factory requires an actual privately validated initial current and only
+ * uses its fixed source parameters, original shell and original bump/cutoff.
+ * It accepts updated velocity and six covariance scalar roots on the SAME G.
+ * The caller must separately authenticate how those roots were produced.
+ */
+export function makeOriginalFullPressureRefresher(initialized,context={}){
+  if(assertGlobalInitializedAngular(initialized)!==true)
+    fail('UNAUTHENTICATED_INITIAL_SOURCE','The source initial private seal did not validate.');
+  const {G,mean}=initialized;
+  const previous=mean.temporal.pressure,current=previous.current,
+    {band}=current,geometry=previous.geometry;
+  const R=geometry.R;
+  const background={b:band.fields.b,V:G.mul(R,band.fields.F),G:band.fields.G};
+  const stress=previous.residual.fullOriginalStress;
+  const {rho,chi}=previous.pressure;
+  const theta=band.coordinates.theta;
+  const fixedSource={band,geometry,background,stress,rho,chi,theta};
+  return function refreshOriginalCurrent({G:graph,fullCurrent,requiredBinding,phase,stage}){
+    if(graph!==G||!fullCurrent||!fullCurrent.covariance||!fullCurrent.meanVelocity)
+      fail('WRONG_GRAPH_OR_INCOMPLETE_CURRENT','Use updated full velocity/mean/covariance on the original exact G.');
+    if(typeof requiredBinding!=='string'||!requiredBinding)
+      fail('MISSING_SOURCE_INPUT_BINDING','CurrentState source input binding is missing.');
+    const result=reconstructUpdatedFullMeanPressure(G,{
+      geometry,background,velocity:fullCurrent.meanVelocity,
+      covariance:fullCurrent.covariance,stress,rho,chi,
+      tag:`GlobalGenericCycle${stage}_${phase}_FullPressure`});
+    if(!result.checks.every(x=>x.pass)||result.mean.fullAngularCovariance!==fullCurrent.covariance)
+      fail('ORIGINAL_FULL_PRESSURE_IDENTITY_FAILED','The original full-current pressure and covariance did not agree.');
+    const fullPressure=G.add(band.fields.pressure,result.pressure.value,fullCurrent.angularPressure);
+    const pde=exactRealCylindricalPDE(G,{geometry:{...geometry,theta},velocity:fullCurrent.velocity,pressure:fullPressure});
+    if(!Array.isArray(pde.conservativeResidual)||pde.conservativeResidual.length!==3)
+      fail('INVALID_ORIGINAL_PHYSICAL_RESIDUAL','Original Cartesian-equivalent full physical residual is missing.');
+    context.onPressureRefresh?.({phase,stage,graphNodes:G.nodes.length,pressureRoot:fullPressure,
+      meanDefectRoots:[result.mean.P,result.mean.Jtheta,result.mean.Jz],PDEResidualRoots:pde.conservativeResidual});
+    return {binding:requiredBinding,entireUpdatedCurrent:true,
+      pressure:fullPressure,residual:pde.conservativeResidual,
+      meanPressure:result.pressure.value,
+      defects:{P:result.mean.P,Jtheta:result.mean.Jtheta,Jz:result.mean.Jz},
+      actualSourceMathUsed:true,numericalValuesOrEnclosuresComputed:false,
+      authorityScope:'Original exact pressure/PDE source AST on supplied complete current; not authentication of successor fields.'};
+  };
+}
