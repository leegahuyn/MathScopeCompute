+  await writeFile(join(dir,'source-initialized-angular.mjs'),`export function assertGlobalInitializedAngular(s){if(s?.seal!=='fixture-original-private')throw Error('NOT_ORIGINAL');return true;}\n`);
+  await writeFile(join(dir,'source-updated-mean-pressure.mjs'),`
+    export function reconstructUpdatedFullMeanPressure(G,{geometry,background,velocity,covariance,stress,rho,chi,tag}){
+      if(!tag.startsWith('GlobalGenericCycle'))throw Error('WRONG_STAGE_TAG');
+      if(velocity.beta!==G.lastExpected.meanVelocity.beta||covariance.rr!==G.lastExpected.covariance.rr)throw Error('STALE_FULL_CURRENT');
+      return {mean:{P:G.fresh(),Jtheta:G.fresh(),Jz:G.fresh(),fullAngularCovariance:covariance},
+              pressure:{value:G.fresh()},checks:[{pass:true}]};
+    }\n`);
+  await writeFile(join(dir,'source-harmonic-assembly.mjs'),`
+    export function exactRealCylindricalPDE(G,{geometry,velocity,pressure}){
+      if(geometry.theta!==G.theta||pressure!==G.lastAddedPressure)throw Error('LOST_PHYSICAL_PRESSURE');
+      if(velocity[0]!==G.lastExpected.velocity[0])throw Error('STALE_PHYSICAL_VELOCITY');
+      return {conservativeResidual:[G.fresh(),G.fresh(),G.fresh()]};
+    }\n`);
+  const {makeOriginalFullPressureRefresher}=await import(pathToFileURL(join(dir,'original-full-pressure-refresh.mjs')).href);
+  const G={nodes:[],theta:0,lastExpected:null,lastAddedPressure:null,
+    fresh(){let n=this.nodes.length;this.nodes.push({op:'source-ast'});return n;},
+    mul(...args){return this.fresh();},
+    add(...args){const n=this.fresh();this.lastAddedPressure=n;return n;}};
+  const r=()=>G.fresh();
+  const geometry={R:r()},
+    band={fields:{b:r(),F:r(),G:r(),pressure:r()},coordinates:{theta:r()}};
+  G.theta=band.coordinates.theta;
+  const original={seal:'fixture-original-private',G,mean:{temporal:{pressure:{current:{band},geometry,
+      residual:{fullOriginalStress:[r(),r()]},pressure:{rho:r(),chi:r()}}}}};
+  const covariance=Object.fromEntries(['rr','rtheta','rz','thetatheta','thetaz','zz'].map(k=>[k,r()]));
+  const current={velocity:[r(),r(),r()],meanVelocity:{beta:r(),v:r(),gamma:r()},covariance,angularPressure:r()};
+  G.lastExpected=current;
+  return {G,original,current,makeOriginalFullPressureRefresher};
+}
+test('generic fresh-pressure adapter consumes current covariance and velocity, creates distinct original-style roots',async()=>{
