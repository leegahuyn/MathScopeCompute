+#!/usr/bin/env node
+/** Optional full-repository entrypoint. Fail-closed without a real factory
+ * that constructs an object accepted by the ORIGINAL private WeakMap seal.
+ * The original source and all 3.8M+ node graph data are NOT embedded here.
+ */
+import {readFile,writeFile,mkdir} from 'node:fs/promises';
+import {resolve,dirname} from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {produceOriginalFirstForced} from './original-initial-forced-bridge.mjs';
+
+const argv=process.argv.slice(2),get=key=>argv.includes(key)?argv[argv.indexOf(key)+1]:null;
+const output=resolve(get('--output')??'MathScope_CurrentState_Actual_Execution_Receipt.json');
+const result={schema:'MathScope.N6.GenericCurrentStateRealBridgeReceipt/1',
+  originalPrivateSourceExecuted:false,stage1OriginalForcedProduced:false,
+  finalRootNumericEnclosures:0,final67JetsNumericCertified:0,
+  originalN706Closed:false,originalN805Closed:false,actualLastResolvedTau:null,
+  release:'HOLD'};
+async function finalize(exitCode){await mkdir(dirname(output),{recursive:true});
+  await writeFile(output,JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));process.exitCode=exitCode;}
+try{
+  const factory=get('--factory'),commit=get('--source-commit');
+  if(!factory||!commit)throw Object.assign(new Error('Supply real initialized-angular factory and pinned source commit.'),{code:'MISSING_PRIVATE_SOURCE_FACTORY'});
+  const module=await import(pathToFileURL(resolve(factory)).href);
+  if(typeof module.createOriginalInitializedAngular!=='function')
+    throw Object.assign(new Error('Factory must export createOriginalInitializedAngular().'),{code:'NO_PRIVATE_FACTORY_EXPORT'});
+  const initialized=await module.createOriginalInitializedAngular();
+  const got=produceOriginalFirstForced(initialized,{sourceCommit:commit});
+  result.originalPrivateSourceExecuted=true;
+  result.stage1OriginalForcedProduced=got.sourceAuthenticatedFirstForced===true;
+  result.generatedGraphNodeCount=got.graphRootIdentifiers.graphNodes;
+  result.producedCurrentRootIdentifiers=got.graphRootIdentifiers.history.map(x=>({stage:x.stage,phase:x.phase,
+    pressureRoot:x.pressureRoot,defects:x.defects}));
+  result.nextRequiredSourceOperator='SIGNED_SUCCESSOR_ON_GENERIC_CURRENT';
+  result.originalSuccessorIsStillMissing=true;
+  await finalize(0);
+}catch(e){
+  result.failure={code:e.code??'ORIGINAL_SOURCE_EXECUTION_FAILED',message:e.message};
+  await finalize(2);
