+    'attachGlobalInitializedMean(','prepareOriginalMeanMapOperatorSeminorms(',
+    'attachInitializedMeanOperatorMajorants(','attachGlobalInitializedAngular('];
+  let previous=-1;for(const call of items){
+    const p=s.indexOf(call,s.indexOf('export async function createOriginalInitializedAngular'));
+    assert.ok(p>previous,`${call} must follow the exact archived source construction order`);previous=p;
+  }
+  assert.match(s,/coefficientOrder:1,maxNodes:3500000/);
+  assert.match(s,/order:1,maxNodes:300000,maxWork:10000/);
+  assert.match(s,/assertGlobalInitializedAngular\(initialized\)/);
+});
diff --git a/research-ide/mathscope-m3/tests/signed-temporal-frontier.test.mjs b/research-ide/mathscope-m3/tests/signed-temporal-frontier.test.mjs
