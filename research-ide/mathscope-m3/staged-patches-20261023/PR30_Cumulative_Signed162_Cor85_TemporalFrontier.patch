+/** Source-specific first transition through the EXISTING private-seal APIs.
+ * This file is meant to sit next to the PR30 source modules. It is never
+ * allowed to call the initial-only signed / forced constructor on a forged
+ * CurrentState or pretend the first Forced update is the full original cycle.
+ *
+ * The subsequent signed / temporal / five generic successors need genuine
+ * new source-bound implementations. This adapter intentionally stops there.
+ */
+import {assertGlobalInitializedAngular} from './source-initialized-angular.mjs';
+import {attachGlobalForcedCurrent,assertGlobalForcedCurrent} from './source-global-forced-current.mjs';
+import {createGenericCurrentSeed,advanceCurrentPhase,currentStateReport} from './generic-current-state.mjs';
+
+const fail=(code,message)=>{const e=new Error(message);e.code=code;throw e;};
+const modesFromTemplates=templates=>templates.map(t=>({
+  label:String(t.key),modes:[...new Set(t.waveRows.map(row=>row.m))]
+}));
+
+export function adaptPrivateInitializedAngular(initialized,{sourceCommit}={}){
+  // This is the ONLY source-specific authority entry: no caller claims about
+  // the seal are trusted; the original imported WeakMap validator must pass.
+  if(assertGlobalInitializedAngular(initialized)!==true)
+    fail('UNAUTHENTICATED_INITIAL_SOURCE','Original initialized angular private seal was not validated.');
+  const {G,mean,initial,global}=initialized;
+  const moments=mean.stages.moments;
+  const b=mean.temporal.pressure.current.band;
+  if(!moments?.mean||!moments?.velocity||!initial?.global?.pressure?.nonzeroAngular)
+    fail('MISSING_INITIAL_SOURCE_OPERANDS','The original private state is incomplete.');
+  const fields={
+    velocity:global.velocity,pressure:global.pressure,
+    residual:global.direct.conservativeResidual,
+    meanVelocity:moments.velocity,meanPressure:moments.pressure.value,
+    angularPressure:initial.global.pressure.nonzeroAngular,
+    covariance:mean.temporal.pressure.covariance.fullAngularMean,
+    defects:{P:moments.mean.P,Jtheta:moments.mean.Jtheta,Jz:moments.mean.Jz},
+    potential:null // Original A/b/p are not fully attached by this state.
+  };
+  const seed=createGenericCurrentSeed({G,
+    source:{sourceCommit,paperSHA256:initialized.source.paperSHA256,
+      parameterExpressionSHA256:initialized.source.parameterExpressionSHA256},
+    fields,modes:modesFromTemplates(initialized.templates)});
+  return {seed,source:initialized,graph:G,provenance:{
+    initializedPrivateSealValidated:true,sourceGraphIdentical:true,
+    numericalFinalFieldCertified:false,originalExactSupremumSelectorEvaluated:false,
+    reason:'The original private initial state has been validated, but the complete final correction family is not yet computed.'}};
+}
+
+export function produceOriginalFirstForced(initialized,{sourceCommit,context={}}={}){
+  const adapted=adaptPrivateInitializedAngular(initialized,{sourceCommit});
+  let result=null;
+  const step=advanceCurrentPhase(adapted.seed,'forced',{
+    produce({stage,phase}){
+      if(stage!==1||phase!=='forced')fail('INITIAL_ONLY_API_USED_FOR_SUCCESSOR','The PR30 constructor currently authenticates only the initial stage.');
+      result=attachGlobalForcedCurrent(initialized,context);
+      assertGlobalForcedCurrent(result);
+      if(result.G!==initialized.G||result.input!==initialized)
+        fail('CROSS_SOURCE_FORCED_CURRENT','The forced current lost its exact original graph or seed.');
+      const full=result.global,mean=result.mean;
+      return {stage,phase,completeCurrent:true,modes:modesFromTemplates(result.templates),
+        fields:{velocity:full.velocity,meanVelocity:mean.completeBetaVGamma,
+          angularPressure:full.allAngularPressure,covariance:mean.fullCurrentCovariance,potential:null}};
+    },
+    refresh({requiredBinding}){
+      // attachGlobalForcedCurrent itself ran the actual full-pressure refresh
+      // BEFORE calculating this complete current's new pressure/residual.
+      assertGlobalForcedCurrent(result);
+      const {global,mean}=result;
+      if(mean.mean.fullAngularCovariance!==mean.fullCurrentCovariance ||
+         !mean.checks.every(x=>x.pass))
+        fail('UNVERIFIED_FORCED_PRESSURE_REFRESH','Only the authenticated full-current pressure refresh is admissible.');
+      return {binding:requiredBinding,entireUpdatedCurrent:true,
+        pressure:global.pressure,residual:global.direct.conservativeResidual,
+        meanPressure:global.fullMeanPressure,
+        defects:{P:mean.mean.P,Jtheta:mean.mean.Jtheta,Jz:mean.mean.Jz}};
+    }
+  });
+  return {schema:'MathScope.N6.PrivateOriginalForcedBridge/1',
+    sourceAuthenticatedFirstForced:true,graphRootIdentifiers:currentStateReport(step),
+    nextPhase:'signed',nextPhaseImplemented:false,
+    firstForced:result,currentState:step,
+    numericalValueEvaluatorAvailable:false,missingOriginalFinalRootsRemain:true,
+    originalFinalJetCount:0,originalN706Closed:false,originalN805Closed:false,
+    requiredNextWork:'Implement original-source Signed successor on the updated full CurrentState with authentic H/covariance/pressure and the complete mode inventory.'};
+}
