index 0000000..3a039b8
--- /dev/null
+++ b/research-ide/mathscope-m3/tests/generic-current-state.test.mjs
@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createGenericCurrentSeed,assertCurrentState,advanceCurrentPhase,runOneCurrentCycle,
+  currentStateReport,buildSymbolicJetRequests,expectedRefreshBinding} from '../navier/generic-current-state.mjs';
+import {originalJetOrders} from '../navier/actual-67-jet-contract.mjs';
+
+const h='a'.repeat(64),k='b'.repeat(64),cov=make=>Object.fromEntries(['rr','rtheta','rz','thetatheta','thetaz','zz'].map(n=>[n,make()]));
+class Graph {
+  constructor(){this.nodes=[];this.value=null;}
+  fresh(op='source_expr',args=[]){const n=this.nodes.length;this.nodes.push({op,args});return n;}
+  derivative(id,wrt){return this.fresh('derivative',[id,wrt]);}
+  add(...args){return this.fresh('add',args);}
+  captureFunctionDefinitions(){return {fixed:true};}
+  functionDefinitionsUnchanged(s){return s?.fixed===true;}
+}
+function create(){
+  const G=new Graph();
+  const coordinates=Object.fromEntries(['x','y','z','tau','s'].map(name=>[name,G.fresh('coordinate',[name])]));
+  const r=()=>G.fresh('source_expr');
+  const fields={velocity:Array.from({length:3},r),pressure:r(),residual:Array.from({length:3},r),
+    meanVelocity:{beta:r(),v:r(),gamma:r()},meanPressure:r(),angularPressure:r(),
+    defects:{P:r(),Jtheta:r(),Jz:r()},covariance:cov(r),potential:{A:[r(),r(),r()],b:r(),p:r()}};
+  const modes=[{label:'cover_0',modes:[-2,-1,1,2]}, {label:'cover_1',modes:[-2,-1,1,2]}];
+  const seed=createGenericCurrentSeed({G,fields,modes,source:{sourceCommit:'example_fixture',paperSHA256:h,parameterExpressionSHA256:k}});
+  return {G,seed,coordinates,r};
+}
+function handlersFor(c,{tamperPhase,missingMode=false,badRefresh=false}={}){
+  const make=(phase)=>({
+    produce({stage,modeInventory}){
+      const currentModes=modeInventory.map(x=>({label:x.label,modes:phase==='forced'?
+        [...x.modes,-4,4,-8,8]:[...x.modes]}));
+      if(missingMode&&phase==='forced')currentModes[0].modes=currentModes[0].modes.filter(x=>x!==-2);
+      return {stage,phase:tamperPhase??phase,completeCurrent:true,modes:currentModes,
+        fields:{velocity:[c.r(),c.r(),c.r()],meanVelocity:{beta:c.r(),v:c.r(),gamma:c.r()},
+          angularPressure:c.r(),covariance:cov(c.r),potential:{A:[c.r(),c.r(),c.r()],b:c.r(),p:c.r()}}};
+    },
+    refresh({requiredBinding}){
+      return {binding:badRefresh?'stale source identity':requiredBinding,entireUpdatedCurrent:true,
+        pressure:c.r(),residual:[c.r(),c.r(),c.r()],meanPressure:c.r(),
+        defects:{P:c.r(),Jtheta:c.r(),Jz:c.r()}};
+    }
+  });
+  return Object.fromEntries(['forced','signed','temporal','five'].map(x=>[x,make(x)]));
+}
+const error=(fn,code)=>assert.throws(fn,e=>e.code===code,code);
+
+test('full four-substep stage creates distinct graph-root IDs, fresh pressure, retained modes',()=>{
+  const c=create(),old=c.G.nodes.length;
+  const s=runOneCurrentCycle(c.seed,handlersFor(c));
+  assertCurrentState(s);
+  const r=currentStateReport(s);
+  assert.equal(r.stage,1);assert.equal(r.phase,'seed');assert.equal(r.history.length,4);
+  assert.equal(r.history.map(x=>x.phase).join(','),'forced,signed,temporal,five');
+  assert.deepEqual(r.modeInventory[0].modes,[-8,-4,-2,-1,1,2,4,8]);
+  assert.ok(r.graphNodes>old);assert.equal(r.numericalSourceFieldsCertified,false);
+  assert.ok(r.history.every(x=>x.newNodeCount>x.oldNodeCount));
+  for(const x of r.history)assert.deepEqual(Object.keys(x.defects).sort(),['Jtheta','Jz','P']);
+});
+test('source graph prefix mutation cannot be used by old state',()=>{
+  const c=create();c.G.nodes[1]={op:'counterfeit',args:[]};error(()=>assertCurrentState(c.seed),'MUTATED_SOURCE_GRAPH');
+});
+test('producer rewriting an old native source node is rejected even if it appends fresh nodes',()=>{
+  const c=create(),o=handlersFor(c),original=o.forced.produce;
+  o.forced.produce=x=>{const y=original(x);c.G.nodes[0]={op:'counterfeit',args:[]};return y;};
+  error(()=>advanceCurrentPhase(c.seed,'forced',o.forced),'MUTATED_SOURCE_GRAPH');
+});
+test('state metadata corruption cannot be reused',()=>{
+  const c=create();c.seed.history.push({phase:'fake'});error(()=>assertCurrentState(c.seed),'INVALID_CURRENT_STATE_SEAL');
+});
+test('reject wrong phase and stale updates',()=>{
+  const c=create();error(()=>advanceCurrentPhase(c.seed,'signed',handlersFor(c).signed),'BAD_PHASE_ORDER');
+  error(()=>advanceCurrentPhase(c.seed,'forced',handlersFor(c,{tamperPhase:'signed'}).forced),'WRONG_PHASE_PROVENANCE');
+});
+test('reject stale refreshed pressure and P/J defects',()=>{
+  const c=create();error(()=>advanceCurrentPhase(c.seed,'forced',handlersFor(c,{badRefresh:true}).forced),'STALE_OR_UNBOUND_PRESSURE_REFRESH');
+});
+test('reject unpaired and dropped harmonics',()=>{
+  const c=create();error(()=>advanceCurrentPhase(c.seed,'forced',handlersFor(c,{missingMode:true}).forced),'INCOMPLETE_CONJUGATE_MODES');
+  const c2=create();const o=handlersFor(c2);o.forced.produce=({stage})=>({stage,phase:'forced',completeCurrent:true,
+    modes:[{label:'cover_0',modes:[-1,1]},{label:'cover_1',modes:[-2,-1,1,2]}],
+    fields:{velocity:[c2.r(),c2.r(),c2.r()],meanVelocity:{beta:c2.r(),v:c2.r(),gamma:c2.r()},
+      angularPressure:c2.r(),covariance:cov(c2.r),potential:{A:[c2.r(),c2.r(),c2.r()],b:c2.r(),p:c2.r()}}});
+  error(()=>advanceCurrentPhase(c2.seed,'forced',o.forced),'DROPPED_PRIOR_HARMONIC');
+});
+test('a missing original Signed successor is not silently replaced by the initial-only operator',()=>{
+  const c=create(),o=handlersFor(c);delete o.signed;
+  error(()=>runOneCurrentCycle(c.seed,o),'MISSING_GENERALIZED_OPERATOR');
+});
+test('the same graph can materialize 67 symbolic derivative roots, but never numerical certificates',()=>{
+  const c=create(),orders=originalJetOrders();
+  const result=buildSymbolicJetRequests(c.seed,orders,c.coordinates);
+  assert.equal(result.total,67);assert.equal(result.numericalFieldEnclosures,false);
+  assert.equal(result.originalN706Closed,false);
+  assert.ok(result.items.every(x=>c.G.nodes[x.expressionRoot]));
+});
+test('original current without gauge/potential roots is rejected for 67-jet extraction',()=>{
+  const c=create();let f={...c.seed.fields,potential:null};const c2=createGenericCurrentSeed({G:c.G,fields:f,
+    modes:c.seed.modes,source:{sourceCommit:'example_fixture',paperSHA256:h,parameterExpressionSHA256:k}});
+  error(()=>buildSymbolicJetRequests(c2,[],c.coordinates),'MISSING_ORIGINAL_POTENTIAL');
+});
+test('fail closed on missing original graph node and invalid source provenance',()=>{
+  const c=create();const f={...c.seed.fields,pressure:9999999};
+  error(()=>createGenericCurrentSeed({G:c.G,fields:f,modes:c.seed.modes,
+    source:{sourceCommit:'fixture',paperSHA256:h,parameterExpressionSHA256:k}}),'INVALID_ACTUAL_GRAPH_ROOT');
+  error(()=>createGenericCurrentSeed({G:c.G,fields:c.seed.fields,modes:c.seed.modes,
+    source:{sourceCommit:'fixture',paperSHA256:'BAD',parameterExpressionSHA256:k}}),'INCOMPLETE_SOURCE_PROVENANCE');
+});
+test('explicit stale refreshed defect scope is rejected',()=>{
+  const c=create(),o=handlersFor(c);o.forced.refresh=({requiredBinding})=>({binding:requiredBinding,entireUpdatedCurrent:false,
+    pressure:c.r(),residual:[c.r(),c.r(),c.r()],meanPressure:c.r(),defects:{P:c.r(),Jtheta:c.r(),Jz:c.r()}});
+  error(()=>advanceCurrentPhase(c.seed,'forced',o.forced),'STALE_OR_UNBOUND_PRESSURE_REFRESH');
+});
diff --git a/research-ide/mathscope-m3/tests/generic-signed-162-indexed.test.mjs b/research-ide/mathscope-m3/tests/generic-signed-162-indexed.test.mjs
