+/** Authentic PR30 initialization recipe, reconstructed verbatim in ordering
+ * from archived global-source-forced-current.test.mjs (attempt1/attempt3).
+ * No fixture fields, caller-overridden coefficients, signs or symbolic roots.
+ *
+ * The bounded first source computation is known to be very expensive. A
+ * constructor that exhausts resources does not yield a private source seal.
+ */
+import {prepareGlobalSourceBand} from './source-global-band.mjs';
+import {attachGlobalFixedRepresentative} from './source-global-representative.mjs';
+import {attachGlobalCurrentState} from './source-global-current.mjs';
+import {attachGlobalMomentCurrent} from './source-global-moment.mjs';
+import {attachGlobalCurrentPressure} from './source-global-pressure.mjs';
+import {attachGlobalTemporalInverse} from './source-global-temporal.mjs';
+import {attachGlobalInitializedMean} from './source-global-initial-mean.mjs';
+import {attachGlobalInitializedAngular,assertGlobalInitializedAngular} from './source-initialized-angular.mjs';
+import {prepareOriginalMeanMapOperatorSeminorms} from './source-fixed-mean-majorants.mjs';
+import {attachInitializedMeanOperatorMajorants,assertInitializedMeanOperatorMajorants} from './source-initialized-mean-majorants.mjs';
+
+export async function createOriginalInitializedAngular(context={}){
+  if(!context||typeof context!=='object'||Array.isArray(context)||
+     Object.keys(context).some(k=>!['onProgress','checkCancelled'].includes(k)))
+    throw Object.assign(new Error('Only bounded original source progress callbacks are accepted.'),{code:'INVALID_ORIGINAL_FACTORY_OPTIONS'});
+  const band=prepareGlobalSourceBand({coefficientOrder:1,maxNodes:3500000},context);
+  const representative=attachGlobalFixedRepresentative(band,context);
+  const current=attachGlobalCurrentState(representative,context);
+  const momentTemplate=attachGlobalMomentCurrent(current,context);
+  const pressure=attachGlobalCurrentPressure(current,context);
+  const temporal=attachGlobalTemporalInverse(pressure,context);
+  const mean=attachGlobalInitializedMean(temporal,momentTemplate,context);
+  // Retain the same fixed mean operator/majorant initialization order
+  // as the original archived full Forced source test. Independent G graph.
+  const norms=await prepareOriginalMeanMapOperatorSeminorms({order:1,maxNodes:300000,maxWork:10000},context);
+  const majorants=attachInitializedMeanOperatorMajorants(mean,norms);
+  if(assertInitializedMeanOperatorMajorants(majorants)!==true)
+    throw Object.assign(new Error('Original mean operator source majorants did not verify.'),{code:'ORIGINAL_SOURCE_MAJORANTS_FAILED'});
+  const initialized=attachGlobalInitializedAngular(mean,context);
+  if(assertGlobalInitializedAngular(initialized)!==true)
+    throw Object.assign(new Error('Original initializer private seal rejected.'),{code:'ORIGINAL_INITIALIZER_SEAL_FAILED'});
+  return initialized;
+}
