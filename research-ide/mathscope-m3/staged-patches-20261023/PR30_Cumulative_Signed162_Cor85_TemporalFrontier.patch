--- /dev/null
+++ b/research-ide/mathscope-m3/tests/signed-temporal-frontier.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,mkdir,writeFile,readFile,copyFile,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join,dirname} from 'node:path';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+const src=fileURLToPath(new URL('../navier/source-signed-temporal-frontier.mjs',import.meta.url));
+async function setUp(){
+ const temp=await mkdtemp(join(tmpdir(),'m3-temporal-'));
+ const nav=join(temp,'research-ide/mathscope-m3/navier');
+ const m0=join(temp,'research-ide/mathscope-m0');
+ await mkdir(nav,{recursive:true});await mkdir(m0,{recursive:true});
+ await copyFile(src,join(nav,'source-signed-temporal-frontier.mjs'));
+ await writeFile(join(nav,'original-signed-162-successor.mjs'),`import {allowed} from './fixture.mjs';export function assertOriginalSigned162Successor(x){if(!allowed.has(x))throw Object.assign(Error('bad source'),{code:'BAD_SIGNED'});return true;}`);
+ await writeFile(join(nav,'source-updated-mean-pressure.mjs'),`export function exactNormalizedHaar(G,x,Y){return G.integral(G.integral(x,Y[0],G.zero,G.one),Y[1],G.zero,G.one)}`);
+ await writeFile(join(m0,'contracts.mjs'),`import {createHash} from 'node:crypto';export const canonicalStringify=x=>JSON.stringify(x);export const sha256=async x=>createHash('sha256').update(x).digest('hex');`);
+ await writeFile(join(nav,'fixture.mjs'),`
+ export const allowed=new WeakSet();
+ export class GClass{
+  constructor(){this.nodes=[];this.zero=this.node('rational',[]);this.one=this.node('rational',[]);}
+  node(op,args){const id=this.nodes.length;this.nodes.push({op,args});return id;}
+  fresh(){return this.node('coordinate',[])}
+  sub(a,b){return this.node('subtract',[a,b]);}
+  integral(a,y,l,r){return this.node('definite_integral',[a,y,l,r]);}
+  freeCoordinates(id){const n=this.nodes[id];if(n.op==='coordinate')return new Set([id]);
+   if(n.op==='definite_integral'){const s=this.freeCoordinates(n.args[0]);s.delete(n.args[1]);return s;}
+   if(n.op==='subtract')return new Set([...this.freeCoordinates(n.args[0]),...this.freeCoordinates(n.args[1])]);return new Set();}
+  captureFunctionDefinitions(){return {pinned:this.nodes.length};}
+  functionDefinitionsUnchanged(s){return this.nodes.length>=s.pinned;}
+ }
+ export function fixture(){const G=new GClass(),n=()=>G.fresh(),Y=[n(),n()],
+  fields={Etheta:n(),Ez:n(),P:n(),Jtheta:n(),Jz:n()},
+  updatedCovariance={rr:n()},pressure=n(),p=n(),
+  band={geometry:{ci:n(),epsilon:n()}},
+  original={geometry:{Y},current:{band}},
+  initial={mean:{temporal:{pressure:original}}},
+  forced={input:initial,source:{paperSHA256:'a'.repeat(64),parameterExpressionSHA256:'b'.repeat(64)}},
+  signed={G,input:forced,constructed:{updated:{updatedMean:{mean:{...fields,fullAngularCovariance:updatedCovariance},
+   pressure:{value:pressure},checks:[{pass:true}]},updatedCovariance,fullPressure:p,
+   pde:{conservativeResidual:[n(),n(),n()]}}}};
+  allowed.add(signed);return {G,signed,updated:signed.constructed.updated,Y,fields};}
+ `);
+ const [fixtureModule,frontier]=await Promise.all([import(pathToFileURL(join(nav,'fixture.mjs')).href),import(pathToFileURL(join(nav,'source-signed-temporal-frontier.mjs')).href)]);
+ return {...fixtureModule,...frontier,temp};
+}
+async function wrap(cb){const s=await setUp();try{await cb(s)}finally{await rm(s.temp,{recursive:true,force:true})}}
+
+test('new post-Signed source is exactly E - double-normalized Haar E with ORIGINAL Y',()=>wrap(async s=>{
+ const x=s.fixture(),f=s.attachSigned162TemporalFrontier(x.signed);
+ assert.equal(f.mean.length,2);assert.equal(f.centered.length,2);
+ for(let j=0;j<2;j++){
+   const outer=x.G.nodes[f.mean[j]],inner=x.G.nodes[outer.args[0]],sub=x.G.nodes[f.centered[j]];
+   assert.equal(outer.op,'definite_integral');assert.equal(inner.op,'definite_integral');
+   assert.equal(inner.args[1],x.Y[0]);assert.equal(outer.args[1],x.Y[1]);
+   assert.equal(sub.op,'subtract');assert.equal(sub.args[0],[x.fields.Etheta,x.fields.Ez][j]);assert.equal(sub.args[1],f.mean[j]);
+ }
+ assert.equal(s.assertSigned162TemporalFrontier(f),true);
+ const c=await s.signed162TemporalFrontierCertificate(f);
+ assert.equal(c.actualZeroMeanInverseExecuted,false);assert.equal(c.actualFiveMapExecuted,false);
+}));
+
+test('unsealed Signed current cannot enter temporal stage',()=>wrap(async s=>{
+ const x=s.fixture();s.allowed.delete(x.signed);
+ assert.throws(()=>s.attachSigned162TemporalFrontier(x.signed),{code:'BAD_SIGNED'});
+}));
+
+test('missing new Signed pressure or post-Signed PDE is rejected',()=>wrap(async s=>{
+ const x=s.fixture();x.updated.fullPressure=x.G.nodes.length+5;
+ assert.throws(()=>s.attachSigned162TemporalFrontier(x.signed),{code:'INCOMPLETE_POST_SIGNED_CURRENT'});
+}));
+
+test('an old mean covariance cannot replace the newly recomputed one',()=>wrap(async s=>{
+ const x=s.fixture();x.updated.updatedMean.mean.fullAngularCovariance={...x.updated.updatedCovariance};
+ assert.throws(()=>s.attachSigned162TemporalFrontier(x.signed),{code:'INCOMPLETE_POST_SIGNED_CURRENT'});
+}));
+
+test('one torus coordinate or non-coordinate fails closed',()=>wrap(async s=>{
+ const x=s.fixture();x.Y[0]=x.G.sub(x.Y[0],x.Y[1]);
+ assert.throws(()=>s.attachSigned162TemporalFrontier(x.signed),{code:'INVALID_ORIGINAL_TORUS'});
+}));
+
+test('changing authenticated centered source or its physical node invalidates the stage seal',()=>wrap(async s=>{
+ const x=s.fixture(),f=s.attachSigned162TemporalFrontier(x.signed);f.centered[0]=x.G.zero;
+ assert.throws(()=>s.assertSigned162TemporalFrontier(f),{code:'INVALID_TEMPORAL_FRONTIER'});
+}));
+
+test('changing the sealed graph expression invalidates the stage',()=>wrap(async s=>{
+ const x=s.fixture(),f=s.attachSigned162TemporalFrontier(x.signed),id=f.centered[0];
+ x.G.nodes[id].op='malicious';
+ assert.throws(()=>s.assertSigned162TemporalFrontier(f),{code:'INVALID_TEMPORAL_FRONTIER'});
+}));
