+/** Only authentic original-source entry to the complete 81x2 Signed indexed AST.
+ * No arbitrary injected original services, no fabricated private seal.
+ * This does NOT issue an original Signed CurrentState source seal.
+ */
+import {assertGlobalForcedCurrent} from './source-global-forced-current.mjs';
+import {assertGlobalInitializedAngular} from './source-initialized-angular.mjs';
+import {exactHarmonicComplexAlgebra,reconstructAngularHarmonics,exactRealCylindricalPDE} from './source-harmonic-assembly.mjs';
+import {exactAngularWaveCovariance} from './source-global-forced-current.mjs';
+import {guardGlobalLocalBody} from './source-global-current.mjs';
+import {reconstructUpdatedFullMeanPressure} from './source-updated-mean-pressure.mjs';
+import {prepareOriginalGenericSignedCandidate} from './original-generic-signed-bridge.mjs';
+import {assembleSigned162Candidate} from './generic-signed-162-indexed.mjs';
+
+export function produceOriginalSigned162AfterForced(actualPrivateForced,options={}){
+  if(assertGlobalForcedCurrent(actualPrivateForced)!==true||
+     assertGlobalInitializedAngular(actualPrivateForced.input)!==true)
+    throw Object.assign(new Error('The original private Forced/Initialized seals are required.'),{code:'INVALID_ORIGINAL_PRIVATE_FORCED'});
+  if(Object.keys(options).some(k=>!['onProgress','candidateMaxAdditionalNodes','assemblyMaxAdditionalNodes','refreshAfterAssembly'].includes(k)))
+    throw Object.assign(new Error('Signed source, target, H, amplitudes, cover and domain are not caller-selectable.'),{code:'INVALID_SIGNED_OPTIONS'});
+  const {onProgress,candidateMaxAdditionalNodes=200000,assemblyMaxAdditionalNodes=1500000,refreshAfterAssembly=true}=options;
+  // This is the only candidate creation permitted in the real source bridge.
+  const signed=prepareOriginalGenericSignedCandidate(actualPrivateForced,{onProgress,maxAdditionalNodes:candidateMaxAdditionalNodes});
+  const composed=assembleSigned162Candidate(signed,{
+    assertForced:assertGlobalForcedCurrent,
+    assertInitialized:assertGlobalInitializedAngular,
+    complex:exactHarmonicComplexAlgebra,
+    reconstruct:reconstructAngularHarmonics,
+    covariance:exactAngularWaveCovariance,
+    guard:guardGlobalLocalBody,
+    refreshMean:reconstructUpdatedFullMeanPressure,
+    physicalPDE:exactRealCylindricalPDE
+  },{onProgress,maxAdditionalNodes:assemblyMaxAdditionalNodes,refreshAfterAssembly});
+  return {...composed,scope:{...composed.scope,
+    originalForcedSourceAssertedByRealModule:true,
+    originalPrivateSignedSuccessorSealIssued:false,
+    actualOriginalFullNumericalFieldsEvaluated:false}};
+}
