index 0000000..5a631de
--- /dev/null
+++ b/research-ide/mathscope-m3/navier/source-signed-temporal-frontier.mjs
@@ -0,0 +1,82 @@
+/** Prop 9.6 Step 3. Exact CURRENT signed-state centered torus source.
+ * Original private Signed successor is mandatory. No earlier pre-Signed
+ * temporal inverse or artificially zeroed auxiliary average is accepted.
+ * This prepares (Eθ - <Eθ>Y, Ez - <Ez>Y); inverse and its tails remain OPEN.
+ */
+import {assertOriginalSigned162Successor} from './original-signed-162-successor.mjs';
+import {exactNormalizedHaar} from './source-updated-mean-pressure.mjs';
+import {canonicalStringify,sha256} from '../../mathscope-m0/contracts.mjs';
+const seals=new WeakMap();
+const fail=(code,message)=>{throw Object.assign(new Error(message),{code});};
+export function attachSigned162TemporalFrontier(signed,context={}){
+  if(!context||typeof context!=='object'||Array.isArray(context)||
+     Object.keys(context).some(k=>!['onProgress','checkCancelled'].includes(k)))
+    fail('INVALID_TEMPORAL_OPTIONS','The source, fields, and inverse are not caller-selectable.');
+  if(assertOriginalSigned162Successor(signed)!==true)
+    fail('MISSING_SIGNED_PRIVATE_SEAL','Only the authenticated original Signed successor is allowed.');
+  const G=signed.G,stage=signed.constructed.updated,
+    original=signed.input.input.mean.temporal.pressure,
+    Y=original.geometry.Y,pressure=signed.input.input.mean.temporal.pressure,
+    band=pressure.current.band;
+  const scalar=id=>Number.isSafeInteger(id)&&id>=0&&!!G.nodes[id];
+  if(!Array.isArray(Y)||Y.length!==2||Y[0]===Y[1]||Y.some(y=>G.nodes[y]?.op!=='coordinate'))
+    fail('INVALID_ORIGINAL_TORUS','Both independent ORIGINAL torus coordinates are mandatory.');
+  const source=[stage?.updatedMean?.mean?.Etheta,stage?.updatedMean?.mean?.Ez],
+    fresh=[stage?.updatedMean?.mean?.P,stage?.updatedMean?.mean?.Jtheta,stage?.updatedMean?.mean?.Jz],
+    p=stage?.updatedMean?.pressure?.value,full=stage?.fullPressure,
+    ci=band?.geometry?.ci,epsilon=band?.geometry?.epsilon;
+  if(!source.every(scalar)||!fresh.every(scalar)||![p,full,ci,epsilon].every(scalar)||
+     stage.updatedMean.mean.fullAngularCovariance!==stage.updatedCovariance||
+     !stage.updatedMean.checks?.length||stage.updatedMean.checks.some(x=>x.pass!==true)||
+     !stage.pde?.conservativeResidual?.every(scalar))
+    fail('INCOMPLETE_POST_SIGNED_CURRENT','Recompute and verify the FULL Signed P/J/pressure/PDE before Temporal.');
+  const start=G.nodes.length,
+    means=source.map(x=>exactNormalizedHaar(G,x,Y)),
+    centered=source.map((x,j)=>G.sub(x,means[j]));
+  if(means.some(x=>Y.some(y=>G.freeCoordinates(x).has(y))))
+    fail('HAAR_MEAN_NOT_A_SCALAR','The exact two-torus Haar average must eliminate both Y coordinates.');
+  const result={schema:'MathScope.N6.SignedTemporalCenteredSourceFrontier/1',G,signed,
+    source:{paperSHA256:signed.input.source.paperSHA256,
+      parameterExpressionSHA256:signed.input.source.parameterExpressionSHA256,
+      previousStep:'AUTHENTICATED_ORIGINAL_SIGNED162_SUCCESSOR',
+      updatedSignedPressure:p,updatedFullPressure:full,updatedDefects:[...fresh],
+      originalTorus:[...Y],originalFastTimeCoefficient:ci,originalEpsilon:epsilon,
+      unaveragedCurrentResidual:[...source]},
+    mean:[...means],centered:[...centered],
+    exactOperation:'E_a^circ = E_a - integral_Y0 integral_Y1 E_a dY1 dY0; inverse N^-1 and its tails NOT executed',
+    requiredNext:['Apply original zero-Haar-mean inverse to these new, not prior, sources.',
+      'Generate original finite Fourier pairs and derivative tails for every requested slow/mixed derivative.',
+      'Realize meridional potential and preserve Fax and the original slow-time/cutoff remainders.',
+      'Recompute pressure and P/J from complete post-Temporal field before new FiveMap.',
+      'Obtain independent common-domain uniform all-order bounds; no finite AST proves these.'],
+    scope:{sameSignedPrivateSource:true,currentPostSignedPressureAndDefectsUsed:true,
+      normalizedTorusMeanComputed:true,exactCenteredSourcesGenerated:true,
+      fourDerivativeAuxiliaryTailsComputed:false,inverseNActuallyConstructed:false,
+      postTemporalPressureReconstructed:false,fiveMomentMapExecuted:false,
+      numerical67JetsComplete:false,originalN706Complete:false,originalN805Complete:false,
+      release:'HOLD'},
+    graph:{before:start,after:G.nodes.length}};
+  context.checkCancelled?.();context.onProgress?.({stage:'signed-temporal-two-new-centered-sources',nodeCount:G.nodes.length});
+  seals.set(result,{G,signed,record:canonicalStringify({source:result.source,mean:result.mean,centered:result.centered,scope:result.scope}),
+    delta:canonicalStringify(G.nodes.slice(start,G.nodes.length)),before:start,after:G.nodes.length,
+    definitions:G.captureFunctionDefinitions()});
+  return result;
+}
+export function assertSigned162TemporalFrontier(x){
+  const s=seals.get(x);
+  if(!s||s.G!==x?.G||s.signed!==x?.signed||
+     s.record!==canonicalStringify({source:x.source,mean:x.mean,centered:x.centered,scope:x.scope})||
+     s.delta!==canonicalStringify(x.G.nodes.slice(s.before,s.after))||
+     !x.G.functionDefinitionsUnchanged(s.definitions))
+    fail('INVALID_TEMPORAL_FRONTIER','Centered original Signed source or graph changed.');
+  assertOriginalSigned162Successor(x.signed);return true;
+}
+export async function signed162TemporalFrontierCertificate(x){
+  assertSigned162TemporalFrontier(x);
+  return {schema:'MathScope.N6.SignedTemporalSourceFrontierCertificate/1',
+    graphSHA256:await sha256(canonicalStringify({source:x.source,means:x.mean,centered:x.centered})),
+    twoCurrentCenteredSourceRoots:x.centered,sourceAuthenticated:true,
+    actualZeroMeanInverseExecuted:false,actualAllOrderFourierTailCertified:false,
+    actualFiveMapExecuted:false,allFiniteStagesCompleted:false,
+    N706Closed:false,N805Closed:false,release:'HOLD'};
+}
diff --git a/research-ide/mathscope-m3/tests/generic-current-state.test.mjs b/research-ide/mathscope-m3/tests/generic-current-state.test.mjs
