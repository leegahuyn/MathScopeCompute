+/** Private original-source successor authority, bound ONLY to the actual
+ * privately sealed PR30 `GlobalActualForcedCurrent` instance.
+ *
+ * The previous Signed162 candidate assembles fields; THIS module mints an
+ * in-process new Signed successor seal only after the real Force/Initial
+ * constructors and the full indexed, pressure, and PDE graph have succeeded.
+ * Recording a JSON receipt alone can never mint that private seal.
+ */
+import {assertGlobalForcedCurrent} from './source-global-forced-current.mjs';
+import {assertGlobalInitializedAngular} from './source-initialized-angular.mjs';
+import {assertGlobalUpdatedMeanStress} from './source-global-updated-mean-stress.mjs';
+import {produceOriginalSigned162AfterForced} from './original-signed-162-bridge.mjs';
+import {auditSigned162SuccessorFacts} from './source-signed-162-successor-audit.mjs';
+import {verifyPR30OriginalSourceFiles,PR30_HEAD} from './source-signed-162-pr30-pins.mjs';
+import {canonicalStringify,sha256} from '../../mathscope-m0/contracts.mjs';
+const seals=new WeakMap();
+const fail=(code,message)=>{throw Object.assign(new Error(message),{code});};
+function record(s){return {
+  schema:s.schema,source:s.source,stage:s.stage,fields:s.audit.indexedFields,
+  roots:s.audit.rootInventory,scope:s.scope,
+  constructionScope:s.constructed.scope,
+  authenticLatestCor85:{Sigma:s.latestStress.Sigma,
+    source:s.latestStress.source,
+    weightedSourceMoments:s.latestStress.compatibility.rows.map(x=>({
+      rawWeightedSourceWhole:x.rawWeightedSourceWhole,rawCutoffRemainder:x.rawCutoffRemainder}))},
+  signedSource:{
+    Sigma:s.constructed.originalCandidate?.signed?.Sigma,
+    weightedSources:s.constructed.originalCandidate?.signed?.integrals?.map(x=>[x.integrand,x.partial,x.whole,x.value,x.cutoffRemainder,x.normalizedHaarMean]),
+    cor85SigmaIdentityBySource:s.constructed.originalCandidate?.signed?.sourceOfSigma,
+    fixedH:s.constructed.originalCandidate?.signed?.inversion?.H,
+    originalPositiveAmplitudes:s.constructed.originalCandidate?.signed?.inversion?.a,
+    signedAmplitudes:s.constructed.originalCandidate?.signed?.inversion?.deltaAmplitude,
+    signedPotentialAndCurl:s.constructed.originalCandidate?.signed?.rows?.map(x=>({
+      signIndex:x.signIndex,deltaAmplitude:x.deltaAmplitude,potential:x.potential,
+      fullCurlLeading:x.curl?.leading,fullCurlRemainder:x.curl?.remainder,
+      pressure:x.homogeneousSignedAngularPressure}))
+  },
+  correctedTemplateRoots:s.constructed.templates.map(t=>({key:t.key,sign:t.sign,
+    fullModes:t.waveRows.map(x=>({m:x.m,velocity:x.velocity,pressure:x.pressure})),
+    signedModes:t.signedRows.map(x=>({m:x.m,velocity:x.velocity,pressure:x.pressure})),
+    beforeCovariance:t.beforeCovariance.values,afterCovariance:t.afterCovariance.values,
+    deltaCovariance:t.deltaCovariance}))
+};}
+function originalAssertions(s){
+  if(assertGlobalForcedCurrent(s.input)!==true||assertGlobalInitializedAngular(s.input.input)!==true||
+     assertGlobalUpdatedMeanStress(s.latestStress)!==true)
+    fail('PR30_PRIVATE_SOURCE_AUTHORITY_FAILED','Real PR30 original source seals did not validate.');
+}
+/** One full source-bound successor from original Force, with immutable code pin.
+ * No injected services, arbitrary target Σ or alternate H/initialization.
+ */
+export async function attachOriginalSigned162Successor(actualPrivateForced,options={}){
+  if(!options||typeof options!=='object'||Array.isArray(options)||
+    Object.keys(options).some(k=>!['onProgress','candidateMaxAdditionalNodes','assemblyMaxAdditionalNodes'].includes(k)))
+    fail('INVALID_SIGNED_SUCCESSOR_OPTIONS','No replacement target or source seals are admitted.');
+  const pins=await verifyPR30OriginalSourceFiles();
+  if(assertGlobalForcedCurrent(actualPrivateForced)!==true||
+    assertGlobalInitializedAngular(actualPrivateForced.input)!==true)
+    fail('PR30_PRIVATE_SOURCE_AUTHORITY_FAILED','Unsealed or altered original first Forced source.');
+  const G=actualPrivateForced.G,start=G.nodes.length,
+    assembled=produceOriginalSigned162AfterForced(actualPrivateForced,{...options,refreshAfterAssembly:true}),
+    latestStress=assembled.originalCandidate?.latestCor85Stress,
+    audit=auditSigned162SuccessorFacts(assembled);
+  // Signed target is now the very same PRIVATE source Corollary 8.5 Sigma.
+  // A separately recomputed unaveraged E is forbidden (Proposition 9.6 Step 2).
+  if(assembled.originalCandidate.signed.sourceOfSigma!=='AUTHENTICATED_ORIGINAL_COR85_NORMALIZED_HAAR'||
+     assembled.originalCandidate.signed.Sigma.some((id,j)=>id!==latestStress.Sigma[j]))
+    fail('SIGNED_COR85_TARGET_MISMATCH','Signed inverse must use the trusted normalized Haar stress roots.');
+  // Appending the Signed expression graph must preserve the original seals.
+  originalAssertions({input:actualPrivateForced,latestStress});
+  if(assembled.G!==G||assembled.originalForced!==actualPrivateForced||audit.allIndexedRows!==1620||
+     latestStress.G!==G||latestStress.input!==actualPrivateForced||
+     latestStress.source.latestCovariance!==actualPrivateForced.mean.fullCurrentCovariance||
+     latestStress.source.latestFullMeanPressure!==actualPrivateForced.mean.pressure.value||
+     !Array.isArray(latestStress.Sigma)||latestStress.Sigma.length!==2)
+    fail('INVALID_SIGNED_SOURCE_LINEAGE','Signed successor must derive from the same original Forced graph.');
+  const end=G.nodes.length,definitions=G.captureFunctionDefinitions(),
+    successor={schema:'MathScope.N6.PR30SourceBoundSigned162Successor/1',G,input:actualPrivateForced,
+      constructed:assembled,audit,latestStress,
+      source:{sourceCommit:PR30_HEAD,sourceBytePins:pins,
+        sameGraphAsOriginalForced:true,privateOriginalForcedSealChecked:true,
+        originalHOrAmplitudesReplaced:false,sourceClassBoundCertified:false,
+        actualUpdatedMeanCor85StressVerified:true,
+        independentSigmaGraphEqualityToSignedCandidateStillOpen:false,
+        signedInverseSigmaIsAuthenticatedCor85Sigma:true},
+      stage:{name:'first-Signed-after-first-Forced',startNodeCount:start,endNodeCount:end,
+        newNodes:end-start,newIndexedFields:10,newRegisteredRows:1620},
+      scope:{actualPrivateSignedSuccessorInProcessSealIssued:true,
+        mathematicalOriginalM3CriterionClosed:false,numerical67FinalJetsComplete:false,
+        actualFinal67JetsEvaluated:0,N706Closed:false,N805Closed:false,
+        originalHigherStageIterationComplete:false,
+        actualWholeKRefinementExecuted:false,release:'HOLD'}};
+  const encoded=canonicalStringify(record(successor)),
+    delta=canonicalStringify(G.nodes.slice(start,end));
+  seals.set(successor,{G,input:actualPrivateForced,latestStress,start,end,encoded,delta,definitions});
+  return successor;
+}
+export function assertOriginalSigned162Successor(s){
+  const seal=seals.get(s);
+  if(!seal||seal.G!==s?.G||seal.input!==s?.input||seal.latestStress!==s?.latestStress||
+     seal.encoded!==canonicalStringify(record(s))||
+     seal.delta!==canonicalStringify(s.G.nodes.slice(seal.start,seal.end))||
+     !s.G.functionDefinitionsUnchanged(seal.definitions))
+    fail('INVALID_ORIGINAL_SIGNED_SUCCESSOR_SEAL','Signed private successor object, its defining graph, or function registry changed.');
+  originalAssertions(s);
+  const current=auditSigned162SuccessorFacts(s.constructed);
+  if(canonicalStringify(current)!==canonicalStringify(s.audit))
+    fail('SIGNED_SUCCESSOR_MUTATION','The Signed field, cover and pressure/PDE provenance changed.');
+  return true;
+}
+/** Hashes are evidence of the freshly executed in-process source graph,
+ * not cryptographic attestation of remote CI or a Navier–Stokes theorem.
+ */
+export async function originalSigned162SuccessorCertificate(s){
+  assertOriginalSigned162Successor(s);const seal=seals.get(s),
+    graphSnapshot={record:record(s),newNodes:s.G.nodes.slice(seal.start,seal.end),
+      definitions:seal.definitions,originalForcedSource:s.input.source};
+  return {schema:'MathScope.N6.PR30SourceBoundSigned162Certificate/1',
+    execution:'AUTHENTIC_ORIGINAL_FIRST_FORCED_TO_FULL_SIGNED162_AST',
+    sourceCommit:PR30_HEAD,sourceBytePins:s.source.sourceBytePins,
+    graph:{startNodeCount:seal.start,endNodeCount:seal.end,deltaNodeCount:seal.end-seal.start,
+      sha256:await sha256(canonicalStringify(graphSnapshot))},
+    fields:s.audit.indexedFields,roots:s.audit.rootInventory,
+    privateSuccessorSealChecked:true,recordedOnly:false,
+    final67FieldNumericalEnclosures:0,
+    latestCor85StressAuthenticated:true,
+    mathematicalAllOrderSourceBoundsEstablished:false,
+    actualWholeKEnergyIntegrated:false,N706Closed:false,N805Closed:false,release:'HOLD'};
+}
+export function originalSigned162SuccessorRoots(s){
+  assertOriginalSigned162Successor(s);
+  return {...s.audit.rootInventory,indexedRoots:s.audit.indexedFields.map(x=>x.root)};
+}
