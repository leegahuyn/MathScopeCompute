+#!/usr/bin/env node
+/** Optional actual PR30 runtime. No initial factory = expected exit 2.
+ * Does not fabricate a private original source object or promote a candidate
+ * to the whole corrected field. Output is bounded metadata, not G.nodes.
+ */
+import {writeFile,mkdir} from 'node:fs/promises';
+import {resolve,dirname} from 'node:path';
+import {pathToFileURL} from 'node:url';
+
+const args=process.argv.slice(2),option=key=>args.includes(key)?args[args.indexOf(key)+1]:null,
+  output=resolve(option('--output')??'MathScope_Original_Signed_AfterForced_Receipt.json');
+const PINNED_PR30_HEAD='a9b3a5b317525f6d0a71e2e356b054c9d25d2e60';
+const receipt={schema:'MathScope.N6.GenericSignedAfterForcedExecutionReceipt/1',
+  repository:'leegahuyn/MathScopeCompute',intendedPullRequest:30,
+  sourceCommit:option('--source-commit'),originalSignedWholeCurrentConstructed:false,
+  realSourceGraphUsed:false,originalPrivateSourceExecuted:false,originalForcedCurrentExecuted:false,
+  sourceSignedCandidateProduced:false,originalFinal67JetsNumericallyEvaluated:0,
+  N706Closed:false,N805Closed:false,actualLastResolvedTau:null,release:'HOLD'};
+async function finish(code){
+  await mkdir(dirname(output),{recursive:true});
+  await writeFile(output,JSON.stringify(receipt,null,2)+'\n');
+  console.log(JSON.stringify(receipt));
+  process.exitCode=code;
+}
+try{
+  const factory=option('--factory');
+  if(!factory||!receipt.sourceCommit)throw Object.assign(new Error('A real private source factory and pinned source commit are required.'),{code:'MISSING_PRIVATE_SOURCE_FACTORY'});
+  if(receipt.sourceCommit!==PINNED_PR30_HEAD)throw Object.assign(new Error('This source adapter was verified against PR30 HEAD '+PINNED_PR30_HEAD+'. Rereview source before changing the pin.'),{code:'SOURCE_COMMIT_MISMATCH'});
+  const {produceOriginalFirstForced}=await import('./original-initial-forced-bridge.mjs');
+  const {prepareOriginalGenericSignedCandidate}=await import('./original-generic-signed-bridge.mjs');
+  const m=await import(pathToFileURL(resolve(factory)).href);
+  if(typeof m.createOriginalInitializedAngular!=='function')throw Object.assign(new Error('Expected the original private initialized-angular constructor.'),{code:'MISSING_PRIVATE_FACTORY_EXPORT'});
+  const initial=await m.createOriginalInitializedAngular();
+  const first=produceOriginalFirstForced(initial,{sourceCommit:receipt.sourceCommit});
+  receipt.realSourceGraphUsed=true;
+  receipt.originalPrivateSourceExecuted=true;
+  receipt.originalForcedCurrentExecuted=first.sourceAuthenticatedFirstForced===true;
+  receipt.firstForcedGraphNodeCount=first.graph.nodes.length;
+  const limitRaw=option('--max-additional-nodes'),limit=limitRaw?Number(limitRaw):200000;
+  const signed=prepareOriginalGenericSignedCandidate(first.firstForced,{maxAdditionalNodes:limit});
+  receipt.sourceSignedCandidateProduced=true;
+  receipt.postSignedCandidateGraphNodeCount=first.graph.nodes.length;
+  receipt.SigmaRootIDs=signed.signed.Sigma;
+  receipt.originalSignedDeltaAmplitudeRootIDs=signed.signed.rows.map(r=>r.deltaAmplitude);
+  receipt.originalSignedLocalPotentialRootIDs=signed.signed.rows.map(r=>r.potential);
+  receipt.originalSignedHomogeneousPressureRootIDs=signed.signed.rows.map(r=>r.homogeneousSignedAngularPressure.imaginary);
+  receipt.missingWholeCurrentGates=signed.requiredNext;
+  await finish(0);
+}catch(e){receipt.error={code:e.code??'ORIGINAL_SIGNED_SOURCE_EXECUTION_FAILED',message:String(e.message).slice(0,400)};await finish(2);}
