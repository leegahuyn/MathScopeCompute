+  assert.equal(result.entireUpdatedCurrent,true);
+  assert.equal(calls.length,1);assert.equal(calls[0].phase,'signed');
+  assert.equal(result.binding,'current-stable-input-digest');
+  assert.ok(result.residual.every(id=>Number.isInteger(id)&&c.G.nodes[id]));
+});
+test('explicitly refuses spoofed private seed and source graph mismatch',async()=>{
+  const c=await mock();const fn=c.makeOriginalFullPressureRefresher(c.original);
+  assert.throws(()=>fn({G:{nodes:[]},fullCurrent:c.current,requiredBinding:'x',phase:'signed',stage:1}),e=>e.code==='WRONG_GRAPH_OR_INCOMPLETE_CURRENT');
