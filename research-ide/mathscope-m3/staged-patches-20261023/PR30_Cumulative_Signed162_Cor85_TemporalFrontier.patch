@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Read-only guard against silently applying the CurrentState patch to drifted PR30 source.
+
+Use: python tools/verify_pr30_original_source.py --repo /path/to/MathScopeCompute
+Never edits any source, Git ref, checkpoint, or manifest.
+"""
+import argparse, json, subprocess, sys
+from pathlib import Path
+EXPECTED_BASE='a9b3a5b317525f6d0a71e2e356b054c9d25d2e60'
+ORIGINAL_BLOBS={
+ 'source-initialized-angular.mjs':'69d9311f93e10e176a53f67958f7bd56e0a5691d',
+ 'source-global-forced-current.mjs':'03c3e125d93a5bd9e66d00c5f237b100c7b48b50',
+ 'source-global-signed.mjs':'26b467473b4e4c09a59b6c302aee5493d55c2e15',
+ 'source-global-current.mjs':'4058059e5438222d4903b5a954bc967bb5faa733',
+ 'source-updated-mean-pressure.mjs':'b9ff97cc3debbfd10323e536d28cfb7d5cba1069',
+ 'source-harmonic-assembly.mjs':'cc8d24fdc2a7790d393aea86204b63c21a86f1b0',
+ 'source-global-temporal.mjs':'04577e8da66311862a17c0ab0fc62491dd366178',
+ 'source-global-initial-mean.mjs':'1178fd5056f8d9901f7c8b5dc13a2390879bddc3',
+}
+def git(repo,*args):
+ r=subprocess.run(['git','-C',str(repo),*args],capture_output=True,text=True)
+ if r.returncode:raise RuntimeError(r.stderr.strip() or f'git failed on {args}')
+ return r.stdout.strip()
+def verify(repo):
+ out={'schema':'MathScope.OriginalSourceReadOnlyGuard/1','expected_base':EXPECTED_BASE,
+      'files':[],'overall':'HOLD'}
+ try:
+  out['head']=git(repo,'rev-parse','HEAD')
+  out['base_is_ancestor']=subprocess.run(['git','-C',str(repo),'merge-base','--is-ancestor',EXPECTED_BASE,out['head']]).returncode==0
+  if not out['base_is_ancestor']:
+   out['blocker']='CURRENT_BRANCH_DOES_NOT_CONTAIN_PR30_BASE'
+  for name,sha in ORIGINAL_BLOBS.items():
+   p=Path(repo)/'research-ide/mathscope-m3/navier'/name
+   observed=git(repo,'hash-object',str(p)) if p.is_file() else None
+   out['files'].append({'name':name,'expected_blob':sha,'actual_blob':observed,'pass':observed==sha})
+  out['source_bytes_match']=all(x['pass'] for x in out['files'])
+  out['pass']=bool(out['source_bytes_match'] and out['base_is_ancestor'])
+  if not out['pass'] and 'blocker' not in out:out['blocker']='SOURCE_BYTES_OR_IMPORT_DRIFT'
+  if out['pass']:out['overall']='SOURCE_BASELINE_VERIFIED_ONLY'
+ except Exception as e:
+  out['pass']=False;out['blocker']=f'SOURCE_READ_ERROR:{e}'
+ return out
+if __name__=='__main__':
+ p=argparse.ArgumentParser();p.add_argument('--repo',type=Path,required=True);p.add_argument('--output',type=Path);a=p.parse_args()
+ result=verify(a.repo);data=json.dumps(result,indent=2,ensure_ascii=False)+'\n';print(data)
+ if a.output:a.output.write_text(data)
+ sys.exit(0 if result['pass'] else 2)
