+/** MathScope M3 / generic CurrentState transition kernel.
+ * This file deliberately does NOT assert original analytic or numeric source
+ * authority: real source states require the separate private-seal adapter.
+ * Existing G.nodes and function definitions are never replaced or faked.
+ */
+import {createHash} from 'node:crypto';
+import {ORIGINAL_JET_KEYS} from './actual-67-jet-contract.mjs';
+
+export const PHASES = Object.freeze(['forced','signed','temporal','five']);
+export const FIVE_FIELDS = Object.freeze(['A0','A1','A2','b','p']);
+const SCHEMA='MathScope.N6.GenericCurrentState/1';
+const fail=(code,message)=>{const e=new Error(message);e.code=code;throw e;};
+const canonical=x=>typeof x==='bigint'?'{"$bigint":'+JSON.stringify(x.toString())+'}':
+  x===null||typeof x!=='object'?JSON.stringify(x):
+  Array.isArray(x)?'['+x.map(canonical).join(',')+']':
+  '{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+canonical(x[k])).join(',')+'}';
+const digest=x=>createHash('sha256').update(canonical(x)).digest('hex');
+const seals=new WeakMap();
+const own=(x,k)=>Object.prototype.hasOwnProperty.call(x,k);
+const hex64=x=>typeof x==='string'&&/^[a-f0-9]{64}$/i.test(x);
+const root=(G,id,name)=>{if(!Number.isSafeInteger(id)||id<0||!G.nodes[id])fail('INVALID_ACTUAL_GRAPH_ROOT',`${name}: integer root absent from this exact graph (${id}).`);return id;};
+const roots=(G,ids,name,length)=>{if(!Array.isArray(ids)||ids.length!==length)fail('INVALID_ROOT_VECTOR',`${name} requires ${length} existing graph roots.`);return ids.map((x,i)=>root(G,x,`${name}[${i}]`));};
+const tuple=(G,obj,name)=>{
+  if(!obj||typeof obj!=='object')fail('INCOMPLETE_FULL_CURRENT',`${name} is required.`);
+  return Object.fromEntries(['beta','v','gamma'].map(k=>[k,root(G,obj[k],`${name}.${k}`)]));
+};
+const DEFECTS=['P','Jtheta','Jz'];
+const COVARIANCE=['rr','rtheta','rz','thetatheta','thetaz','zz'];
+const covariance=(G,obj)=>{
+  if(!obj||typeof obj!=='object')fail('MISSING_FULL_COVARIANCE','All six current auxiliary covariance components are required.');
+  return Object.fromEntries(COVARIANCE.map(k=>[k,root(G,obj[k],`covariance.${k}`)]));
+};
+const defects=(G,obj)=>{
+  if(!obj||typeof obj!=='object')fail('MISSING_FRESH_DEFECTS','P, Jtheta and Jz must all be recomputed from the latest current.');
+  return Object.fromEntries(DEFECTS.map(k=>[k,root(G,obj[k],`defects.${k}`)]));
+};
+const scope={sourceFieldEnclosureComputed:false,originalSelectorEvaluated:false,analyticAllOrderSourceBoundsProved:false,
+  originalM3AcceptanceClosed:false,originalFinalJetCount:0};
+const modeInventory=(current,previous=null)=>{
+  if(!Array.isArray(current)||!current.length)fail('MISSING_MODE_INVENTORY','Every live cover-label harmonic inventory is required.');
+  const keys=new Set(),result=[];
+  for(const item of current){
+    const {label,modes}=item||{};
+    if(typeof label!=='string'||!label||keys.has(label)||!Array.isArray(modes)||!modes.length)
+      fail('INVALID_COVER_LABEL','Use each actual fixed-label mode group exactly once.');
+    keys.add(label);const s=new Set(modes);
+    if(s.size!==modes.length||[...s].some(m=>!Number.isSafeInteger(m)||m===0||!s.has(-m)))
+      fail('INCOMPLETE_CONJUGATE_MODES',`Each ${label} mode must have its negative conjugate.`);
+    const ordered=[...s].sort((a,b)=>a-b);
+    result.push({label,modes:ordered});
+  }
+  result.sort((a,b)=>a.label.localeCompare(b.label));
+  if(previous){
+    if(result.length!==previous.length)fail('DROPPED_OR_INSERTED_COVER_LABEL','Fixed source cover labels may not be omitted or inserted.');
+    for(const p of previous){const n=result.find(x=>x.label===p.label);
+      if(!n)fail('DROPPED_OR_INSERTED_COVER_LABEL',`Missing fixed cover ${p.label}.`);
+      if(p.modes.some(m=>!n.modes.includes(m)))fail('DROPPED_PRIOR_HARMONIC',`The ${p.label} full current discarded a preceding harmonic.`);
+    }
+  }
+  return result;
+};
+function validateFields(G,x,requirePotential=false){
+  if(!x||typeof x!=='object')fail('INCOMPLETE_FULL_CURRENT','Full current root set is required.');
+  const y={velocity:roots(G,x.velocity,'velocity',3),pressure:root(G,x.pressure,'pressure'),
+    residual:roots(G,x.residual,'residual',3),meanVelocity:tuple(G,x.meanVelocity,'meanVelocity'),
+    meanPressure:root(G,x.meanPressure,'meanPressure'),angularPressure:root(G,x.angularPressure,'angularPressure'),
+    covariance:covariance(G,x.covariance),defects:defects(G,x.defects)};
+  if(x.potential!==undefined&&x.potential!==null){const a=x.potential;
+    y.potential={A:roots(G,a.A,'A',3),b:root(G,a.b,'b'),p:root(G,a.p,'p')};
+  }else{y.potential=null;if(requirePotential)fail('MISSING_ORIGINAL_POTENTIAL','Original vector potential, swirl and pressure are not attached.');}
+  return y;
+}
+function digestNodePrefix(G,count){
+  // Stream each complete AST node directly into SHA-256: memory is O(1)
+  // in graph length, including multi-million-node original source graphs.
+  const h=createHash('sha256');
+  for(let index=0;index<count;index++){
+    if(!G.nodes[index])fail('GRAPH_NODE_HOLE',`Absent node at ${index}.`);
+    h.update(String(index));h.update('\0');
+    h.update(canonical(G.nodes[index]));h.update('\n');
+  }
+  return h.digest('hex');
+}
+function graphSeal(G){
+  if(!Array.isArray(G?.nodes))fail('MISSING_SOURCE_GRAPH','CurrentState requires the actual shared G.nodes array.');
+  return {count:G.nodes.length, graphSHA256:digestNodePrefix(G,G.nodes.length),
+    definitions:typeof G.captureFunctionDefinitions==='function'?G.captureFunctionDefinitions():null};
+}
+function checkGraphSeal(G,seal){
+  if(G.nodes.length<seal.count||digestNodePrefix(G,seal.count)!==seal.graphSHA256)
+    fail('MUTATED_SOURCE_GRAPH','Original graph node prefix was modified or truncated.');
+  if(seal.definitions!==null&&(!G.functionDefinitionsUnchanged||!G.functionDefinitionsUnchanged(seal.definitions)))
+    fail('MUTATED_SOURCE_FUNCTION_DEFINITIONS','Original function-definition registry changed.');
+}
+function stamp(G,mode,fields,modes,source,history,stage,phase){
+  const state={schema:SCHEMA,G,mode,fields,modes,source,history,stage,phase,scope:{...scope}};
+  const snapshot=graphSeal(G),body={mode,fields,modes,source,history,stage,phase};
+  seals.set(state,{graph:G,snapshot,bodySHA256:digest(body)});return state;
+}
+export function assertCurrentState(state){
+  const seal=seals.get(state);
+  if(!seal||seal.graph!==state.G||seal.bodySHA256!==digest({mode:state.mode,fields:state.fields,modes:state.modes,
+     source:state.source,history:state.history,stage:state.stage,phase:state.phase}))
+    fail('INVALID_CURRENT_STATE_SEAL','Only an unchanged state returned by this exact producer may be used.');
+  checkGraphSeal(state.G,seal.snapshot);return true;
+}
+function sourceMetadata(data){
+  if(!data||!hex64(data.parameterExpressionSHA256)||!hex64(data.paperSHA256)||
+      typeof data.sourceCommit!=='string'||!data.sourceCommit)
+    fail('INCOMPLETE_SOURCE_PROVENANCE','Source commit, original PDF and parameter-expression SHA256 are mandatory.');
+  return Object.freeze({sourceCommit:data.sourceCommit,paperSHA256:data.paperSHA256,
+    parameterExpressionSHA256:data.parameterExpressionSHA256,
+    originalSourceAuthenticated:false,reason:'The generic adapter cannot recreate original private source seals.'});
+}
+export function createGenericCurrentSeed({G,source,fields,modes}={}){
+  const md=sourceMetadata(source),f=validateFields(G,fields),inventory=modeInventory(modes);
+  return stamp(G,'GENERIC_EXECUTABLE_FIXTURE_OR_UNVERIFIED_INPUT',f,inventory,md,[],0,'seed');
+}
+const digestFields=fields=>digest({velocity:fields.velocity,meanVelocity:fields.meanVelocity,
+  angularPressure:fields.angularPressure,covariance:fields.covariance,potential:fields.potential});
+export function expectedRefreshBinding(fields,phase,stage){return digest({phase,stage,producedFullCurrent:digestFields(fields)});}
+export function advanceCurrentPhase(state,kind,{produce,refresh}={}){
+  assertCurrentState(state);
+  if(typeof produce!=='function'||typeof refresh!=='function')fail('MISSING_ACTUAL_PHASE_PRODUCER','Both full-current phase and fresh pressure/residual producer are required.');
+  const index=PHASES.indexOf(kind),expected=PHASES.indexOf(state.phase)+1;
