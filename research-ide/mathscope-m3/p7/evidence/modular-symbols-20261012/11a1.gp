J(v)={my(t=type(v));if(t=="t_VEC"||t=="t_COL",return(Str("[",strjoin(vector(#v,i,J(v[i])),","),"]")));if(t=="t_INT"||t=="t_FRAC",return(Str("\"",v,"\"")));error("unsupported_json_type");};
Rows(A)=vector(matsize(A)[1],i,vector(matsize(A)[2],j,A[i,j]));
Aug(v)={if(type(v)=="t_INT",return(v));if(type(v)=="t_MAT",return(sum(k=1,matsize(v)[1],v[k,2])));error("unsupported_relation_coefficient");};
iferr({setrand(1);A=[(0),(-1),(1),(-10),(-20)];E=ellinit(A);N=ellglobalred(E)[1];M=msinit(N,2,1);H=msnew(M);P=[2,3,5,7,N];AP=vector(#P,i,ellap(E,P[i]));S=msfromhecke(M,vector(#P,i,[P[i],AP[i]]),H);if(matsize(S)[2]!=1,error("eigenspace_not_one_dimensional"));s=H[1]*S[,1];pivot=0;for(i=1,#s,if(s[i]!=0,pivot=i;break));if(pivot==0,error("zero_symbol"));divisor=s[pivot];s=s/divisor;F=vector(msdim(M),i,mseval(M,matid(msdim(M))[,i],[oo,0]));PG=mspathgens(M);G=PG[1];REL=PG[2];V=vector(#G,i,mseval(M,s,G[i]));RB=matrix(#REL,#G);for(i=1,#REL,for(j=1,#REL[i],term=REL[i][j];RB[i,term[2]]+=Aug(term[1])));OUT=[version(),A,[msgetlevel(M),msgetweight(M),msgetsign(M),msdim(M),msdim(H),matsize(S)[2]],Rows(H[1]),Rows(S),s,pivot,divisor,F,[mseval(M,s,[oo,0]),mseval(M,s,[0,oo]),mseval(M,s,[0,0])],msissymbol(M,s),vector(#P,i,[P[i],AP[i],Rows(mshecke(M,P[i])),Rows(mshecke(M,P[i],H))]),msqexpansion(M,s,12),Rows(msstar(M)),V,msissymbol(M,V),[mseval(M,2*s,[oo,0]),mseval(M,-s,[oo,0])],Rows(RB)];print("MATHSCOPE_P7_MODULAR_SYMBOLS_V1=",J(OUT));},err,print("MATHSCOPE_P7_MODULAR_SYMBOL_ERROR");quit(1));quit(0);
