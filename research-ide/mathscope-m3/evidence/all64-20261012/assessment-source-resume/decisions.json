  "criterionDecisions": {
    "N6-04": {
      "reason": "고정 H/a와 전체 81개 label의 B(W0,LΣ)=Σ, 세 종류 remainder를 실제 source에서 검증했다. j=0 초기화·모든 차수 class는 별도 N6-01/07 요구다. 과거 receipt의 false 판정은 그대로 남겼다.",
      "gates": [
        "global-signed"
      ]
    },
    "N7-01": {
      "reason": "원래 공통 초기 조건·양의 mean map·고정 역연산자를 실행한 뒤 같은 qBig에 원문 domain 정리를 적용했다. support, 초기 zero interval, 고정 K와 unit plateau를 확인했다.",
      "gates": [
        "domain-exterior"
      ]
    },
    "N6-06": {
      "reason": "같은 원래 source에서 다섯 적분·두 보존량을 보정한 뒤 전체 보조 토러스 압력과 비선형(8.26)/(8.27)을 재계산했다. 원래 작은 양의 λ의 조건수 배율도 유지했다.",
      "gates": [
        "global-moment-full-pressure"
      ]
    },
    "N7-07": {
      "reason": "같은 열린 내부 영역에서 모든 원문 보정 연산의 지지가 사라지는 증명을 새로 실행해 실제 경로를 식별했다. 양의 e0 하한과 전체 Cτ^(2h) 꼬리를 모든 충분히 작은 양의 τ에 연결했다.",
      "gates": [
        "core-restriction",
        "domain-exterior"
      ]
    },
    "N8-04": {
      "reason": "같은 최종 장의 내부 경로에 세 성분 구간을 연결하고, 정확한 양의 τ·s=-logτ·물리 배율·요청한 소수 예시와 더 작은 시간의 재현을 확인했다.",
      "gates": [
        "core-restriction",
        "near-terminal"
      ]
    },
    "N7-02": {
      "reason": "원문 cutoff와 계수에 연결한 전체 curl·10개 교차항을 직접 residual 계산과 대조했다. 모든 다항식 계수가 일치하고 div u=0을 구조적으로 확인했다.",
      "gates": [
        "localization-operator",
        "domain-exterior"
      ]
    },
    "N7-03": {
      "reason": "같은 원문의 압력과 전체 force로 Poisson 항등식을 검증했다. 실제 외부 영역의 비영 div f를 유지하고 Leray projection 없이 cutoff·압력 조건을 보존했다.",
      "gates": [
        "localization-operator",
        "domain-exterior"
      ]
    },
    "N7-08": {
      "reason": "원문은 비교·배율·지지 분리 주기화를 검토하고 같은 force/data·주기적 압력·에너지 가정을 유지하도록 요구한다. 실제 source cutoff의 정확한 배율·미분·전체 PDE와 간격을 검증했으며 미완료 전역 가정을 보존한다. 별도 N7-06 계산이나 무조건 C/D 발급을 추가 조건으로 붙이지 않는다.",
      "gates": [
        "periodization-review",
        "localization-operator",
        "domain-exterior"
      ]
    },
    "N6-05": {
      "reason": "전체 원문 current/pressure의 실제 zero-mean Fourier 역연산과 N 항등식, m+4 도함수·전체 꼬리·각 느린 도함수별 bound를 구성했다. 원래 ci·T1·A1·느린 시간 항을 유지한다. 이후 pressure/moment/j0는 별도 N6-01 조건이다.",
      "gates": [
        "global-temporal"
      ]
    }
  },
