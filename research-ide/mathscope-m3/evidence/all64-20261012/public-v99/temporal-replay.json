",\\\"packingInstructionsURL\\\":\\\"https://github.com/leegahuyn/MathScopeCompute/blob/mathscope-m3-resume-20261012/research-ide/mathscope-m3/navier/evidence/PACKED_EVIDENCE.md\\\",\\\"sourceValidation\\\":{\\\"mode\\\":\\\"BUILD_TIME_BYTE_VERIFICATION\\\",\\\"allCapturedSourceFilesMatch\\\":true,\\\"allRecordedArtifactBytesMatch\\\":true,\\\"historicalFailuresPreserved\\\":true,\\\"browserHasReexecutedConstructor\\\":false},\\\"summary\\\":{\\\"source\\\":{\\\"sameActualGlobalCurrent\\\":true,\\\"paperSHA256\\\":\\\"0e779481c4da40bd28d1e642e1d8ca57447d129610df28dfa5a11e9af8ae228f\\\",\\\"parameterExpressionSHA256\\\":\\\"e44aab5d21cbe4205d0333d7d73b646444ebaa282d67b2034edfde1e4180f152\\\",\\\"actualFullPressureGraphInput\\\":true,\\\"originalM2Modified\\\":false,\\\"callerBodyOrBoundsAccepted\\\":false,\\\"sourcePrefixCount\\\":1695984,\\\"materializationBudget\\\":{\\\"previousMaximumNodes\\\":3500000,\\\"maximumTotalNodes\\\":5000000,\\\"sourceNodeCountAtDeclaration\\\":1695984,\\\"mathematicalSourceChanged\\\":false,\\\"finiteDerivativeOrdersTruncated\\\":false,\\\"resourceLimitIsNotAMathematicalBound\\\":true}},\\\"periodicity\\\":{\\\"checks\\\":[{\\\"id\\\":\\\"same-original-two-dimensional-time-direction\\\",\\\"pass\\\":true},{\\\"id\\\":\\\"all81-both-sign-full-curl-periodic-bodies\\\",\\\"pass\\\":true},{\\\"id\\\":\\\"original-integer-torus-cover-and-flat-joins\\\",\\\"pass\\\":true},{\\\"id\\\":\\\"actual-full-pressure-before-temporal-inverse\\\",\\\"pass\\\":true},{\\\"id\\\":\\\"original-slow-factors-constant-in-auxiliary-coordinates\\\",\\\"pass\\\":true}],\\\"sourceAuthenticated\\\":true,\\\"sourceBodyRoots\\\":{\\\"theta\\\":643053,\\\"z\\\":643068},\\\"originalParameterExpressionSHA256\\\":\\\"e44aab5d21cbe4205d0333d7d73b646444ebaa282d67b2034edfde1e4180f152\\\",\\\"completeCommonTorusCoverProof\\\":{\\\"qDomain\\\":{\\\"referenceChart\\\":\\\"The original (R,Z,T), with T>=0, q=Q_ref*s>0 and 1/2<=s<=2.\\\",\\\"q\\\":622830,\\\"qGlobalStar\\\":634227,\\\"nextScale\\\":617515,\\\"nextScaleTimesQ\\\":634228,\\\"conditions\\\":[\\\"0<q<qGlobalStar\\\",\\\"b_(N+1)*q>=1\\\"],\\\"prefixOrder\\\":1,\\\"exactPrefixProof\\\":\\\"The actual common b_n is monotone. For n>=N+1, b_n*q>=1; the original time cutoff and all its derivatives are exactly zero, including at the flat endpoint.\\\",\\\"prefixSharedByAllCoverLabels\\\":true,\\\"prefixSharedByWholeRadialIntegral\\\":true,\\\"bandFloorProof\\\":\\\"q<2^(-(ell0+4)) implies -log2(q)>ell0+4. Every active |ell+log2(q)|<3/4 therefore has ell>=ell0.\\\",\\\"compatibleAtlas\\\":\\\"For any two prefix orders valid at this same q, every extra coefficient is exactly zero together with all derivatives. The backgrounds, phases, original matrices, Volterra solutions, H and fixed positive a coincide by ODE uniqueness. The actual monotone b_n>=2^n makes these prefix domains cover every q>0.\\\",\\\"commonSequenceReplaced\\\":false,\\\"oneFinitePrefixClaimedValidAtAllQ\\\":false},\\\"referenceBaseEll\\\":634231,\\\"referenceCommonIndex\\\":634241,\\\"sourceCoveringDifference\\\":{\\\"ell0AtLeast\\\":8,\\\"sourceHUpper\\\":\\\"1/64\\\",\\\"maximumDifference\\\":4,\\\"pass\\\":true},\\\"exactOriginalMatrixPowers\\\":[[[\\\"1\\\",\\\"0\\\"],[\\\"0\\\",\\\"1\\\"]],[[\\\"3\\\",\\\"1\\\"],[\\\"1\\\",\\\"5\\\"]],[[\\\"10\\\",\\\"8\\\"],[\\\"8\\\",\\\"26\\\"]],[[\\\"38\\\",\\\"50\\\"],[\\\"50\\\",\\\"138\\\"]],[[\\\"164\\\",\\\"288\\\"],[\\\"288\\\",\\\"740\\\"]]],\\\"integerRange\\\":{\\\"minimum\\\":0,\\\"maximum\\\":4,\\\"proof\\\":[\\\"On the reference chart 1/2<=s<=2, the complete nearest-band candidates satisfy ell_ref-2<=ell_label<=ell_ref+2.\\\",\\\"The declared q<2^(-(ell0+4)) and q>=Q_ref/2 imply ell_ref>ell0+3, so ell_ref-2>=8.\\\",\\\"The original index f(ell)=((1+h)*ell*log2-2*log ell)/log Tg is increasing for ell>=8: log2>1/2 and2/ell<=1/4.\\\",\\\"Thus i_label-i(ell_ref-2) is a nonnegative integer. The original certified four-band covering-difference bound gives i_label-i0<=4.\\\"]},\\\"localFinitenessAndFlatJoins\\\":\\\"For each fixed physical label, differentiate its complete local body first. In a reference chart the multiplier is ratio^(2A+a/2+b*D+c). Only then use the complete 81-candidate relabeling.\\\",\\\"allCrossLabelProductsVanish\\\":true,\\\"haarInvariance\\\":{\\\"coveringDegrees\\\":[\\\"1\\\",\\\"14\\\",\\\"196\\\",\\\"2744\\\",\\\"38416\\\"],\\\"normalizedMeasure\\\":true,\\\"rule\\\":\\\"Every integer Jg^delta torus cover preserves normalized Haar integral: 14^delta inverse lifts times Jacobian14^(-delta) equals1.\\\",\\\"localChangeOfVariables\\\":\\\"dY_label=Dgeom*ci_label*d_xi*d_v; both actual full-curl signs carry the same angular1/2 already present in their local body.\\\",\\\"existingExactHaarMeans\\\":{\\\"rr\\\":633676,\\\"rtheta\\\":633677,\\\"rz\\\":633678,\\\"thetatheta\\\":633679,\\\"thetaz\\\":633680,\\\"zz\\\":633681},\\\"allSixRetained\\\":true,\\\"noExtraCoveringMultiplicity\\\":true,\\\"mechanicalIntegralReduction\\\":false},\\\"fixedPhysicalRadialIntegration\\\":\\\"The complete indexed operation reindexes at each radial integration argument. Labels active only elsewhere in the interval are therefore retained.\\\",\\\"sourcePeriodicity\\\":\\\"Jg^delta has integer entries. Every local compact rectangle has the original flat auxiliary joins, so the pullback is smooth and1-periodic in each common torus coordinate.\\\",\\\"exactSourceAuthority\\\":true,\\\"newLeanProof\\\":false},\\\"exactSmoothnessDerivation\\\":[\\\"Every retained local pulse is the original finite-interval linear Volterra solution with its smooth original coefficients. Differentiating the equation gives the retained finite variational systems.\\\",\\\"The actual primary potential is multiplied by the original flat auxiliary cutoffs before its full curl. All local derivatives therefore have the same zero join across every compact rectangle boundary.\\\",\\\"The original integer common-torus maps preserve smooth periodic joins. The co