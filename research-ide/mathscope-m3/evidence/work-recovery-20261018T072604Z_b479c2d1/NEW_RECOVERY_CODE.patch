+    total=Q(0)
+    for powers, coefficient in terms.items():
+        term=Q(coefficient)
+        for power, order, value in zip(powers,orders,point):
+            if order>power:
+                term=0
+                break
+            for k in range(order):
+                term*=power-k
+            term*=value**(power-order)
+        total+=term
+    return total
