+def check(name, condition):
+    if not condition:
+        raise AssertionError(name)
+    checks.append({'id':name,'pass':True})
+
+
+def rejects(name, call, code):
+    try:
+        call()
+    except ValueError as e:
+        check(name, str(e)==code)
+    else:
+        raise AssertionError(name+' unexpectedly accepted')
+
