+    'duplicate_quantity_probe': duplicate,
+    'historical_backend_checks_rerun': False,
+    'fixture_values_claimed_as_actual_source': False,
+}
+encoded = json.dumps(record, indent=2) + '\n'
+(HERE / 'INDEPENDENT_PROBES.json').write_text(encoded)
+print(encoded, end='')
