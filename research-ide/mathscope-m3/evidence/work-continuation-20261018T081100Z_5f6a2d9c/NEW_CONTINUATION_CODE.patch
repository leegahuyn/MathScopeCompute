+assert duplicate == {'rejected': True, 'message': 'DISTINCT_NONEMPTY_QUANTITIES_REQUIRED'}
+
+record = {
+    'subject_path': str(SUBJECT.relative_to(ROOT)),
+    'subject_sha256': hashlib.sha256(SUBJECT.read_bytes()).hexdigest(),
